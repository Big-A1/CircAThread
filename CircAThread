function AC_render(){
  if(!AC_traces.length)return;
  const canvas=document.getElementById('TC');
  document.getElementById('AC-ph').style.display='none';canvas.style.display='block';
  const dpi=+document.getElementById('AC-dpi').value,smW=+document.getElementById('AC-sm').value||11,lnW=+document.getElementById('AC-lw').value||2;
  const sPk=document.getElementById('AC-pk').checked,sTr=document.getElementById('AC-tr').checked,sGr=document.getElementById('AC-gr').checked,sLg=document.getElementById('AC-lg').checked,sLb=document.getElementById('AC-lb').checked,doNm=document.getElementById('AC-nm').checked;
  const ttl=document.getElementById('AC-ttl').value,sub=document.getElementById('AC-sub').value;
  const mtp=dpi/25.4,PW=Math.round(180*mtp),PH=Math.round(120*mtp);
  canvas.width=PW;canvas.height=PH;const sc=dpi/96;
  const F=sz=>`${Math.round(sz*sc)}px 'DM Mono',monospace`,FH=sz=>`${Math.round(sz*sc)}px 'Syne',sans-serif`;
  const BGS={dark:{bg:'#1c2738',text:'#dde6f0',t2:'#7f9ab0',t3:'#4a6070',grid:'rgba(255,255,255,0.06)',axis:'rgba(255,255,255,0.2)',zero:'rgba(255,255,255,0.12)',rim:'rgba(20,28,38,0.7)',lbox:'rgba(28,39,56,0.82)'},white:{bg:'#ffffff',text:'#1a1a2e',t2:'#444466',t3:'#888aaa',grid:'rgba(0,0,0,0.07)',axis:'rgba(0,0,0,0.3)',zero:'rgba(0,0,0,0.15)',rim:'rgba(255,255,255,0.9)',lbox:'rgba(255,255,255,0.88)'},offwhite:{bg:'#f5f5f0',text:'#1a1a2e',t2:'#444466',t3:'#888aaa',grid:'rgba(0,0,0,0.07)',axis:'rgba(0,0,0,0.3)',zero:'rgba(0,0,0,0.15)',rim:'rgba(245,245,240,0.9)',lbox:'rgba(245,245,240,0.88)'}};
  const C=BGS[AC_bg]||BGS.dark;
  const rp=sLb?90*sc:24*sc,PAD={l:68*sc,r:rp,t:(ttl||sub?52:28)*sc,b:52*sc};
  const PW2=PW-PAD.l-PAD.r,PH2=PH-PAD.t-PAD.b;
  const ctx=canvas.getContext('2d');ctx.fillStyle=C.bg;ctx.fillRect(0,0,PW,PH);
  if(ttl){ctx.fillStyle=C.text;ctx.font=FH(13);ctx.textAlign='center';ctx.fillText(ttl,PW/2,18*sc)}
  if(sub){ctx.fillStyle=C.t2;ctx.font=F(9);ctx.textAlign='center';ctx.fillText(sub,PW/2,(ttl?32:18)*sc)}
  const xDiv=(AC_xunit==='days')?24:1;
  const xAxisLabel=(xDiv===24)?'Elapsed time (days)':'Elapsed time (h)';
  const proc=AC_traces.map(t=>{const times=t.pairs.map(p=>p[0]);let vals=t.pairs.map(p=>p[1]);if(doNm)vals=normV(vals);const d=detect(times,vals,smW);const p2=PALS[AC_palKey];const dash=(p2.d&&p2.d.length)?p2.d[t.di%p2.d.length]:[];return{...t,times,vals,dash,...d}});
  const allT=proc.flatMap(t=>t.times),minT=Math.min(...allT),maxT=Math.max(...allT);
  const allV=proc.flatMap(t=>t.vals),minV=Math.min(...allV),maxV=Math.max(...allV),vp2=(maxV-minV)*.1;
  const vLo=minV-vp2,vHi=maxV+vp2;
  const cx=t=>PAD.l+(t-minT)/(maxT-minT)*PW2,cy=v=>PAD.t+(1-(v-vLo)/(vHi-vLo))*PH2;
  if(sGr){ctx.strokeStyle=C.grid;ctx.lineWidth=0.6*sc;ctx.setLineDash([3*sc,5*sc]);for(let t=Math.ceil(minT/24)*24;t<=maxT;t+=24){const x=cx(t);ctx.beginPath();ctx.moveTo(x,PAD.t);ctx.lineTo(x,PAD.t+PH2);ctx.stroke()}for(let f of[0,.25,.5,.75,1]){const y=cy(vLo+f*(vHi-vLo));ctx.beginPath();ctx.moveTo(PAD.l,y);ctx.lineTo(PAD.l+PW2,y);ctx.stroke()}ctx.setLineDash([])}
  if(vLo<0&&vHi>0){ctx.strokeStyle=C.zero;ctx.lineWidth=0.8*sc;ctx.setLineDash([3*sc,4*sc]);ctx.beginPath();ctx.moveTo(PAD.l,cy(0));ctx.lineTo(PAD.l+PW2,cy(0));ctx.stroke();ctx.setLineDash([])}
  ctx.strokeStyle=C.axis;ctx.lineWidth=1.2*sc;ctx.beginPath();ctx.moveTo(PAD.l,PAD.t);ctx.lineTo(PAD.l,PAD.t+PH2);ctx.lineTo(PAD.l+PW2,PAD.t+PH2);ctx.stroke();
  ctx.fillStyle=C.t3;ctx.font=F(8);ctx.textAlign='center';
