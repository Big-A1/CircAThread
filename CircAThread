    ctx.beginPath();ctx.strokeStyle=avgCol;ctx.lineWidth=(lnW+1.5)*sc;ctx.lineJoin='round';ctx.setLineDash([]);
    gridT.forEach((t,i)=>i===0?ctx.moveTo(cx(t),cy(avgV[i])):ctx.lineTo(cx(t),cy(avgV[i])));
    ctx.stroke();
  }

  const lw2=document.getElementById('AC-lw2');
  const doAvgLeg=document.getElementById('AC-avg')?.checked;
  if(sLg&&proc.length){lw2.innerHTML=proc.map(t=>`<div class="legitem"><div class="legdot" style="background:${t.color==='#000000'?'#555':t.color}"></div><span>${esc(t.label)}</span><span style="color:var(--text3)">· ${t.per.toFixed(1)}h</span></div>`).join('')+(doAvgLeg&&proc.length>=2?`<div class="legitem"><div class="legdot" style="background:${C.bg==='#ffffff'||C.bg==='#f5f5f0'?'#111':'#fff'}"></div><span style="font-weight:600">Mean ± SEM (n=${proc.length})</span></div>`:'')}else lw2.innerHTML='';
  AC_st(`${proc.length} trace(s) · ${dpi} dpi`,'ok');document.getElementById('AC-exp').disabled=false;
}

