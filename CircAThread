<script>
'use strict';

/* ── TAB SWITCHING ─────────────────────────────────────────── */
function faqToggle(btn){
  const item = btn.closest('.faq-item');
  item.classList.toggle('open');
}

function switchTab(tab){
  document.querySelectorAll('.tab-panel').forEach(p=>p.classList.remove('active'));
  document.querySelectorAll('.tab-btn').forEach(b=>b.classList.remove('active-treat','active-trace','active-trend','active-faq'));
  document.getElementById('panel-'+tab).classList.add('active');
  const btn=document.getElementById('tab-'+tab);
  if(tab==='treat')btn.classList.add('active-treat');
  else if(tab==='trace')btn.classList.add('active-trace');
  else if(tab==='trend')btn.classList.add('active-trend');
  else btn.classList.add('active-faq');
  // Offer shared files to the destination tab
  if(tab==='treat') SHARED_syncToTreat();
  if(tab==='trace') SHARED_syncToTrace();
  if(tab==='trend') SHARED_syncToTrend();
  window.scrollTo({top:0,behavior:'smooth'});
}

/* ══════════════════════════════════════════════════════════════
   SHARED FILE STORE
   Keeps raw CSV text across tabs so files loaded in one tab are
   automatically offered in the other two.
══════════════════════════════════════════════════════════════ */
const SHARED_files = [];   // [{name, text}]

function SHARED_add(name, text){
  if(!SHARED_files.find(f=>f.name===name)) SHARED_files.push({name, text});
}
function SHARED_remove(name){
  const i=SHARED_files.findIndex(f=>f.name===name);
  if(i>-1) SHARED_files.splice(i,1);
}

// Render the shared-files banner inside a given drop zone wrapper element.
// `presentNames` = names already loaded in that tab (don't offer duplicates).
// `onAccept(file)` called for each accepted file object-like {name,text}.
// `onDismiss(name)` called when user removes from shared store entirely.
function SHARED_renderBanner(containerId, presentNames, onAccept, onRemove){
  const el=document.getElementById(containerId); if(!el) return;
  const pending=SHARED_files.filter(f=>!presentNames.includes(f.name));
  let banner=el.querySelector('.shared-banner');
  if(!pending.length){ if(banner) banner.remove(); return; }
  if(!banner){ banner=document.createElement('div'); banner.className='shared-banner'; el.prepend(banner); }
  banner.innerHTML=`
    <div style="font-size:9px;color:var(--text3);letter-spacing:.06em;text-transform:uppercase;margin-bottom:5px">
      Files from other tabs — click to load:
    </div>
    <div style="display:flex;flex-wrap:wrap;gap:4px">
      ${pending.map(f=>`
        <div style="display:flex;align-items:center;gap:0;background:var(--bg3);border:1px solid var(--border2);border-radius:4px;overflow:hidden;max-width:220px">
          <button class="sh-accept" data-name="${esc(f.name)}"
            style="background:none;border:none;color:var(--accent);font-size:10px;padding:3px 7px;cursor:pointer;font-family:var(--fm);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;max-width:170px"
            title="Load ${esc(f.name)}">${esc(f.name.replace(/\.[^.]+$/,'').slice(0,22))}</button>
          <button class="sh-remove" data-name="${esc(f.name)}"
            style="background:none;border:none;border-left:1px solid var(--border);color:var(--text3);font-size:12px;padding:2px 5px;cursor:pointer;line-height:1;flex-shrink:0"
            title="Remove from shared store">×</button>
        </div>`).join('')}
    </div>
    <div style="font-size:9px;color:var(--text3);margin-top:5px">× dismisses from all tabs · click name to load into this tab</div>`;
  banner.querySelectorAll('.sh-accept').forEach(btn=>{
    btn.addEventListener('click',()=>{
      const f=SHARED_files.find(x=>x.name===btn.dataset.name); if(!f) return;
      onAccept(f);
    });
  });
  banner.querySelectorAll('.sh-remove').forEach(btn=>{
    btn.addEventListener('click',()=>{
      SHARED_remove(btn.dataset.name);
      onRemove();
    });
  });
}

// Sync to CircATrace
function SHARED_syncToTrace(){
  const presentNames=AC_traces.map(t=>t.fn);
  SHARED_renderBanner('AC-dz-wrap', presentNames,
    f=>{
      try{
        const pairs=parseCSV(f.text,f.name);
        const idx=AC_traces.length, p=PALS[AC_palKey];
        AC_traces.push({fn:f.name,label:f.name.replace(/\.[^.]+$/,''),pairs,color:p.c[idx%p.c.length],di:idx%Math.max(1,p.d.length)});
        AC_renderList();
        AC_st(`Loaded "${f.name}" from shared store — click Render.`,'ok');
        document.getElementById('AC-exp').disabled=!AC_traces.length;
      }catch(e){AC_st(e.message,'err');}
      SHARED_syncToTrace();  // refresh banner
    },
    ()=>SHARED_syncToTrace()
  );
}

// Sync to CircATreat
function SHARED_syncToTreat(){
  const presentNames=AT_files.map(f=>f.name);
  SHARED_renderBanner('AT-dz-wrap', presentNames,
    f=>{
      if(!AT_files.find(x=>x.name===f.name)){
        AT_files.push({name:f.name, csv:f.text, rsISO:'2026-03-30T08:00'});
        AT_renderFileList();
        AT_st(`Loaded "${f.name}" from shared store.`,'');
      }
      SHARED_syncToTreat();
    },
    ()=>SHARED_syncToTreat()
  );
}

// Sync to CircATrends
function SHARED_syncToTrend(){
  const presentNames=TR_rows.map(r=>r.filename);
  SHARED_renderBanner('TR-dz-wrap', presentNames,
    f=>{
      let range=null;
      try{ const rngs=TR_getRanges(); range=rngs?rngs[0]:null; }catch(e){}
      const anchorMode=TR_getAnchor();
      try{
        const {peaks,troughs,period,phase,amplitude,magnitude,risingPeriod,fallingPeriod}=TR_extractFromLumiCSV(f.text,f.name,range,anchorMode);
        TR_batchCounter++;
        TR_rows.push({id:f.name.replace(/\.[^.]+$/,''),filename:f.name,batchId:TR_batchCounter,peaks,troughs,period,phase,amplitude,magnitude,risingPeriod,fallingPeriod,group:''});
        TR_renderTable();
        document.getElementById('TR-rowcnt').textContent=`${TR_rows.length} samples`;
        ['TR-savexl','TR-savexl2'].forEach(id=>{const el=document.getElementById(id);if(el)el.disabled=false});
        TR_updateStartPeakDropdown();
        TR_st(`Loaded "${f.name}" from shared store.`,'ok');
      }catch(e){TR_st(e.message,'err');}
      SHARED_syncToTrend();  // refresh banner
    },
    ()=>SHARED_syncToTrend()
  );
}

/* ══════════════════════════════════════════════════════════════
   SHARED — CSV PARSER
══════════════════════════════════════════════════════════════ */
function parseCSV(text,fname){
  const rows=text.replace(/\r\n/g,'\n').replace(/\r/g,'\n').split('\n').map(l=>l.split(','));
  const SE=['counts/sec','count/s','cps','counts per'],SF=['signal','raw','intensity','biolum','photon'];
  let tc=null,sc=null,tu='hours',hi=-1;
  for(let ri=0;ri<rows.length;ri++){
    const row=rows[ri];if(!row.some(c=>c.trim()))continue;
    const L=row.map(c=>c.toLowerCase().trim());if(L.length<3)continue;
    let tc2=null,sc2=null,tu2='hours',best=-1;
    L.forEach((c,j)=>{let s=-1;if(c.includes('day'))s=4;else if(c.startsWith('elapsed'))s=3;else if(c.includes('hr')&&!c.includes('min'))s=2;else if(c.includes('hour'))s=2;else if(c.includes('min')&&!c.includes('hr'))s=1;else if(c.includes('time')&&!c.includes(':'))s=0;if(s>best){best=s;tc2=j;tu2=c.includes('day')?'days':(c.includes('min')&&!c.includes('hr'))?'minutes':'hours'}});
    L.forEach((c,j)=>{if(j===tc2)return;if(sc2===null&&SE.some(k=>c.includes(k)))sc2=j});
    if(sc2===null)L.forEach((c,j)=>{if(j===tc2)return;if(sc2===null&&SF.some(k=>c.includes(k)))sc2=j});
    if(tc2!==null&&sc2!==null&&ri+1<rows.length){const nr=rows[ri+1];const tv=parseFloat((nr[tc2]||'').trim().replace(',',''));const sv=parseFloat((nr[sc2]||'').trim().replace(',',''));if(!isNaN(tv)&&!isNaN(sv)){tc=tc2;sc=sc2;tu=tu2;hi=ri;break}}
  }
  if(tc===null||sc===null){for(let ri=0;ri<rows.length;ri++){const s=rows[ri].map(c=>c.trim());if(s.length>=5){const a=parseFloat(s[0]),b=parseFloat(s[3]),c2=parseFloat(s[4]);if(!isNaN(a)&&!isNaN(b)&&!isNaN(c2)&&b<500){tc=3;sc=4;tu='days';hi=ri-1;break}}}}
  if(tc===null||sc===null)throw new Error(`${fname}: cannot find time/signal columns`);
  const dp=[];
  for(let ri=hi+1;ri<rows.length;ri++){const row=rows[ri];if(row.length<=Math.max(tc,sc))continue;const t=parseFloat(row[tc].trim().replace(',',''));const v=parseFloat(row[sc].trim().replace(',',''));if(!isNaN(t)&&!isNaN(v))dp.push([t,v])}
  if(dp.length<10)throw new Error(`${fname}: only ${dp.length} rows`);
  dp.sort((a,b)=>a[0]-b[0]);
  let pairs=dp;
  if(tu==='days')pairs=dp.map(([t,v])=>[t*24,v]);
  else if(tu==='minutes')pairs=dp.map(([t,v])=>[t/60,v]);
  else{const mx=dp[dp.length-1][0];if(mx>500)pairs=dp.map(([t,v])=>[t/60,v]);else if(mx>30000)pairs=dp.map(([t,v])=>[t/3600,v]);else if(mx<20&&dp.length>100)pairs=dp.map(([t,v])=>[t*24,v])}
  return pairs;
}

/* ── SHARED DSP ────────────────────────────────────────────── */
function smth(arr,w){w=Math.max(1,Math.floor(w));return arr.map((_,i)=>{const lo=Math.max(0,i-w),hi2=Math.min(arr.length,i+w+1);return arr.slice(lo,hi2).reduce((a,b)=>a+b,0)/(hi2-lo)})}
function detect(times,vals,W=5){
  const sm=smth(vals,W);const pk=[],tr=[];
  for(let i=W;i<sm.length-W;i++){let ip=true,it=true;for(let j=i-W;j<=i+W;j++){if(j===i)continue;if(sm[i]<sm[j])ip=false;if(sm[i]>sm[j])it=false}if(ip)pk.push({t:times[i],v:vals[i]});if(it)tr.push({t:times[i],v:vals[i]})}
  let per=24;if(pk.length>=2){const ivs=pk.slice(1).map((p,k)=>p.t-pk[k].t).filter(v=>v>=16&&v<=36);if(ivs.length)per=ivs.reduce((a,b)=>a+b)/ivs.length}
  return{pk,tr,per,sm};
}
function normV(vals){const mn=Math.min(...vals),mx=Math.max(...vals);return vals.map(v=>(v-mn)/(mx-mn||1))}
function esc(s){return s.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;')}

/* ════════════════════════════════════════════════════════════
