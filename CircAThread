// ── Render the coordinate table ───────────────────────────
function TR_updateStartPeakDropdown(){
  const sel = document.getElementById('TR-startpeak');
  if(!sel) return;
  const cur = sel.value || 'pk:0';
  const maxPk = TR_rows.length ? Math.max(...TR_rows.map(r=>r.peaks.length))   : 1;
  const maxTr = TR_rows.length ? Math.max(...TR_rows.map(r=>r.troughs.length)) : 1;
  const pkOpts = Array.from({length:maxPk}, (_,i)=>
    `<option value="pk:${i}"${cur===`pk:${i}`?' selected':''}>Peak ${i+1}${i===0?' (all)':''}</option>`
  ).join('');
  const trOpts = Array.from({length:maxTr}, (_,i)=>
    `<option value="tr:${i}"${cur===`tr:${i}`?' selected':''}>Trough ${i+1}${i===0?' (all)':''}</option>`
  ).join('');
  sel.innerHTML =
    `<optgroup label="From peak">${pkOpts}</optgroup>` +
    `<optgroup label="From trough">${trOpts}</optgroup>`;
}

// Parse the dropdown value → {type:'pk'|'tr', idx:number}
function TR_parseStart(){
  const raw = document.getElementById('TR-startpeak')?.value || 'pk:0';
  const [type, idx] = raw.split(':');
  return { type, idx: parseInt(idx)||0 };
}
document.addEventListener('change', e=>{
  if(e.target&&e.target.id==='TR-startpeak') TR_renderTable();
});

