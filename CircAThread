function TR_loadFiles(files){
  const csvs = files.filter(f=>/\.(csv|txt)$/i.test(f.name));
  if(!csvs.length){ TR_st('No CSV files found in drop.','err'); return; }
  let done=0, errs=[];
  // Read range and anchor at load time
  let range = null;
  try{ const rngs=TR_getRanges(); range=rngs?rngs[0]:null; }catch(e){ TR_st(e.message,'err'); return; }
  const anchorMode = TR_getAnchor();
  // Each call to TR_loadFiles = one batch (one drop / one browse action)
  TR_batchCounter++;
  const thisBatch = TR_batchCounter;
  csvs.forEach(f=>{
    const r=new FileReader();
    r.onload=ev=>{
      try{
        const {peaks,troughs,period,phase,amplitude,magnitude,risingPeriod,fallingPeriod} = TR_extractFromLumiCSV(ev.target.result, f.name, range, anchorMode);
        SHARED_add(f.name, ev.target.result);
        const id = f.name.replace(/\.[^.]+$/,'');
        TR_rows.push({id, filename:f.name, batchId:thisBatch, peaks, troughs, period, phase, amplitude, magnitude, risingPeriod, fallingPeriod, group:''});
        done++;
      }catch(er){ errs.push(er.message) }
      if(done+errs.length===csvs.length){
        TR_renderTable();
        document.getElementById('TR-rowcnt').textContent=`${TR_rows.length} samples`;
        ['TR-savexl','TR-savexl2'].forEach(id=>{const el=document.getElementById(id);if(el)el.disabled=TR_rows.length===0});
        const msg = errs.length
          ? `Added ${done}, errors: ${errs.join(' | ')}`
          : `Added ${done} file(s) [Batch ${thisBatch}]. Total: ${TR_rows.length} samples.`;
        TR_st(msg, errs.length?'err':'ok');
        TR_updateStartPeakDropdown();
      }
    };
    r.readAsText(f);
  });
}

