  ];

  for(let ri=0;ri<nRanges;ri++){
    const rr0=AT_results[0].rangeResults[ri];
    const optData=AT_computeOptimum(AT_results,ctRaws,ri,AT_getCassette());
    lines.push('',`═══════════════════════`,`RANGE: ${rr0.label} (h${rr0.from}–h${rr0.to})`,`═══════════════════════`);
    lines.push('--- Absolute (per replicate) ---');
    AT_results.forEach(r=>{
      const rngRes=r.rangeResults[ri];
      lines.push(`\n  ${r.filename}  (period ${rngRes?.period?.toFixed(2)||'?'} h, anchor: ${rngRes?.anchorClk?fdt(rngRes.anchorClk):'?'})`);
      rngRes?.treatments.forEach(t=>{
        const ctLbl=AT_offsetToCtLabel(t.offset,AT_getCassette(),rngRes.period);
        lines.push(`    ${String(t.label).padEnd(12)}${ctLbl?' ('+ctLbl+')':''.padEnd(8)} ${fdt(t.clock).padEnd(32)} ${t.phase}`);
      });
    });
    lines.push('','--- Optimum (consensus) ---');
    optData.filter(Boolean).forEach(o=>{
      const ctLbl=AT_offsetToCtLabel(o.offset,AT_getCassette(),meanPeriod);
      lines.push(`  ${String(o.label).padEnd(12)}${ctLbl?' ('+ctLbl+')':''.padEnd(8)} ${fdt(o.optClock).padEnd(32)} spread: ${o.spreadMin.toFixed(0)} min ${o.consensus?'[✓ CONSENSUS]':'[⚠ wide]'}  ${o.phase}`);
    });
    if(ri===0){
      lines.push('','--- 7-day rolling schedule (optimum, first range) ---');
      optData.filter(Boolean).forEach(o=>{
        lines.push(`\n  ${o.label} — ${o.phase}`);
        Array.from({length:7},(_,d)=>lines.push(`    Day ${d+1}: ${fdt(new Date(o.optClock.getTime()+d*meanPeriod*3600000))}`));
      });
    }
  }
  lines.push(`\nMean period drift: ${(meanPeriod-24).toFixed(2)} h/day`);

  const a=document.createElement('a');
  a.href=URL.createObjectURL(new Blob([lines.join('\n')],{type:'text/plain'}));
  a.download='CircATreat_schedule.txt'; a.click();
};

