// ── Reporter cassette ─────────────────────────────────────
// Maps select value → CT of peak (hours, 0–23.9).
// null = no cassette selected, suppress CT annotation.
const AT_CASSETTE_PEAK_CT = {
  bmal1:   0,
  clock:   0,
  per1:    8,
  per2:   12,
  per3:   10,
  cry1:   16,
  cry2:   14,
  reverba: 4,
  rora:   20,
  dbp:     8,
  tef:     8,
  custom: null,   // resolved dynamically
  none:   null,
};
const AT_CASSETTE_NAMES = {
  bmal1:'Bmal1::Luc', clock:'Clock::Luc', per1:'Per1::Luc', per2:'Per2::Luc',
  per3:'Per3::Luc', cry1:'Cry1::Luc', cry2:'Cry2::Luc', reverba:'Rev-erbα::Luc',
  rora:'RORα::Luc', dbp:'Dbp::Luc', tef:'Tef::Luc', custom:'Custom', none:'None',
};

function AT_getCassette(){
  const val = document.getElementById('AT-cassette')?.value || 'none';
  if(val==='custom'){
    const ct = parseFloat(document.getElementById('AT-custom-ct')?.value);
    return isNaN(ct) ? null : ct;
  }
  return AT_CASSETTE_PEAK_CT[val] ?? null;  // null = no annotation
}

function AT_getCassetteName(){
  const val = document.getElementById('AT-cassette')?.value || 'none';
  return AT_CASSETTE_NAMES[val] || 'Unknown';
}

// Convert hours-from-peak-anchor → CT string, given that the peak = peakCT
// Returns e.g. "CT12" or null if no cassette selected
function AT_offsetToCtLabel(offsetH, peakCT, periodH){
  if(peakCT === null || peakCT === undefined) return null;
  const period = periodH || 24;
  const ct = ((peakCT + offsetH) % period + period) % period;
  const ctRounded = Math.round(ct * 10) / 10;
  return `CT${ctRounded % 1 === 0 ? ctRounded.toFixed(0) : ctRounded.toFixed(1)}`;
}

// Show/hide custom CT row
document.getElementById('AT-cassette').addEventListener('change', function(){
  const row = document.getElementById('AT-custom-ct-row');
  row.style.display = this.value === 'custom' ? 'flex' : 'none';
});
// Parse a treatment label → {offset: hours from anchor, label: display string}
// Accepts: "Peak" (0h), "Trough" (half-period), "h+6", "h-3", bare number, legacy CTN
// AT_parseCT(raw, peakCT)
// ─────────────────────────────────────────────────────────────────────────────
// Parses a treatment time entry and returns {offset, label, isCT}.
//
// Two modes depending on entry type:
//
//   Peak-relative (reporter-agnostic):
//     "Peak"    → offset = 0   (treat at the peak itself)
//     "Trough"  → offset = 12  (treat at the trough, ~half-period from peak)
//     "h+6"     → offset = +6  (6 h after detected peak)
//     bare num  → offset = N   (N hours after detected peak)
//
//   Circadian-time absolute (cassette-dependent):
//     "CT8" / "ZT8" → isCT = true
//     When a cassette is selected (peakCT ≠ null), the peak of THAT reporter
//     sits at peakCT on the CT scale.  To treat at CT8 you therefore need to
//     apply a peak-relative offset of:  CT8 − peakCT  (mod period).
//     e.g. Bmal1::Luc (peakCT=0):  CT8  → offset = 8 − 0 = +8 h after peak
//          Per2::Luc  (peakCT=12): CT8  → offset = 8 − 12 = −4 h (= 20 h after peak)
//     When NO cassette is selected (peakCT = null), CT/ZT entries are treated
//     as hours-after-peak (legacy behaviour) and a warning is appended to label.
function AT_parseCT(raw, peakCT=null){
  const s=raw.trim();
  if(/^peak$/i.test(s))   return {offset:0,  label:s, isCT:false};
  if(/^trough$/i.test(s)) return {offset:12, label:s, isCT:false};
  const hm=s.match(/^h([+-]\d+(?:\.\d+)?)$/i);
  if(hm) return {offset:parseFloat(hm[1]), label:s, isCT:false};
  const nm=s.match(/^([+-]?\d+(?:\.\d+)?)$/);
  if(nm) return {offset:parseFloat(nm[1]), label:s, isCT:false};
  const ctm=s.match(/^(?:ct|zt)\s*([+-]?\d+(?:\.\d+)?)$/i);
  if(ctm){
    const ctVal=parseFloat(ctm[1]);
    if(peakCT !== null){
      // Cassette known: convert absolute CT → peak-relative offset
      const offset = ctVal - peakCT;   // may be negative; caller wraps mod period
      return {offset, label:s, isCT:true, ctVal};
    } else {
      // No cassette: fall back to treating CT value as hours-after-peak
      return {offset:ctVal, label:s+'*', isCT:true, ctVal, noCassette:true};
    }
  }
  throw new Error(`Cannot parse treatment time: "${raw}". Use CT0/ZT0, CT12, CT20, Peak, Trough, h+6, or a bare number.`);
}
// Waveform position descriptor — reporter-agnostic, based on fractional cycle position
function AT_phase(offsetH, periodH){
  const period=periodH||24;
  const frac=((offsetH%period)+period)%period/period;
  if(frac<0.08||frac>=0.92) return 'Peak (anchor)';
  if(frac<0.20) return 'Early descending';
  if(frac<0.38) return 'Mid descending';
  if(frac<0.54) return 'Nadir / trough';
  if(frac<0.62) return 'Early ascending';
  if(frac<0.80) return 'Mid ascending';
  return 'Late ascending';
}
// Colour by fractional cycle position
function AT_col(offsetH, periodH){
  const period=periodH||24;
  const frac=((offsetH%period)+period)%period/period;
  if(frac<0.08||frac>=0.92) return '#f97316';
  if(frac>=0.38&&frac<0.62) return '#34d399';
  return '#60a5fa';
}
function fdt(dt){return dt.toLocaleDateString('en-GB',{weekday:'short',day:'2-digit',month:'short',year:'numeric'})+' '+dt.toLocaleTimeString('en-GB',{hour:'2-digit',minute:'2-digit'})}
function ft(dt){return dt.toLocaleTimeString('en-GB',{hour:'2-digit',minute:'2-digit'})}
function fd(dt){return dt.toLocaleDateString('en-GB',{weekday:'short',day:'2-digit',month:'short'})}
function AT_getCTs(){return[...document.querySelectorAll('#AT-tl input[type="text"]')].map(i=>i.value).filter(v=>v.trim())}
function AT_st(m,t=''){const el=document.getElementById('AT-st');el.textContent=m;el.className='st'+(t?' '+t:'')}

// ── Demo data generator ───────────────────────────────────
function AT_demo(seed=0){
  const period=23.8+seed*0.15, sd=0.65139+seed*0.08, rows=[];
  for(let i=0;i<576;i++){
    const tD=sd+i/(6*24);
    rows.push([tD*24, 5000+3000*Math.cos(2*Math.PI*tD/period)+600*Math.cos(2*Math.PI*tD/(period/2)+0.7)+300*(((i*7+seed*13)%17)/17-0.5)+(seed*200)]);
  }
  return rows;
}

// ── Per-file analysis ─────────────────────────────────────
function AT_runOne(pairs, rsISO, ctRaws, peakCT=null){
  const rs=new Date(rsISO); if(isNaN(rs)) throw new Error('Invalid recording start');
  const times=pairs.map(p=>p[0]), vals=pairs.map(p=>p[1]);
  let pk,tr,per;
  for(const Wt of [5,4,3,2,1]){
    const W=Math.min(Wt,Math.floor(times.length/10)||Wt);
    ({pk,tr,per}=detect(times,vals,W));
    if(pk.length>=2) break;
  }
  if(pk.length<2) throw new Error('Fewer than 2 peaks detected — need a longer/more rhythmic recording.');
  const totalH=times[times.length-1]-times[0];
  const mid=pk.filter(p=>p.t>=totalH*.1&&p.t<=totalH*.9);
  const ct0=(mid.length>=1?mid:pk).reduce((a,b)=>b.v>a.v?b:a);
  const ct0clk=new Date(rs.getTime()+ct0.t*3600000);
  const treatments=ctRaws.map(raw=>{
    const {offset,label,noCassette}=AT_parseCT(raw, peakCT);
    // Wrap negative offsets into the positive cycle
    const normOffset=((offset%(per||24))+(per||24))%(per||24);
    const ms=ct0clk.getTime()+normOffset*(per/24)*3600000;
    return{offset:normOffset, label, clock:new Date(ms), schedule:Array.from({length:7},(_,d)=>new Date(ms+d*per*3600000)), phase:AT_phase(normOffset,per), colour:AT_col(normOffset,per), noCassette};
  });
  // Wrap in rangeResults for compatibility with AT_computeOptimum and AT_render
  const rangeResult={label:'Full recording',from:times[0],to:times[times.length-1],colour:'rgba(96,165,250,0.0)',
                     times,vals,peaks:pk,troughs:tr,period:per,anchor:ct0,anchorClk:ct0clk,anchorCT:0,treatments};
  return{pairs,times,vals,peaks:pk,troughs:tr,period:per,totalH,rs,ct0,ct0clk,
         rangeResults:[rangeResult]};
}

// ── Optimum time computation ──────────────────────────────
// rangeIdx: which rangeResult slot to use (0 = first / only range)
function AT_computeOptimum(results, ctRaws, rangeIdx=0, peakCT=null){
  return ctRaws.map(raw=>{
    const {offset,label}=AT_parseCT(raw, peakCT);
    const clocks=results
      .map(r=>(r.rangeResults[rangeIdx]||r.rangeResults[0]).treatments.find(t=>t.label===label)?.clock)
      .filter(Boolean);
    if(!clocks.length) return null;
    const minsArr=clocks.map(d=>d.getHours()*60+d.getMinutes()+d.getSeconds()/60);
    const rad=minsArr.map(m=>m/1440*2*Math.PI);
    const sx=rad.reduce((s,r)=>s+Math.sin(r),0)/rad.length;
    const sy=rad.reduce((s,r)=>s+Math.cos(r),0)/rad.length;
    const meanRad=Math.atan2(sx,sy);
    const meanMins=((meanRad/(2*Math.PI)*1440)+1440)%1440;
    const devsMin=minsArr.map(m=>{let d=Math.abs(m-meanMins);if(d>720)d=1440-d;return d;});
    const spreadMin=Math.max(...devsMin)*2;
    const anchor=new Date(clocks[0]); anchor.setHours(0,0,0,0);
    const optClock=new Date(anchor.getTime()+meanMins*60000);
    const consensus=spreadMin<=20;
    const meanPer=results.reduce((s,r)=>s+r.period,0)/results.length;
    return{offset,label,clocks,optClock,spreadMin,consensus,phase:AT_phase(offset,meanPer),colour:AT_col(offset,meanPer)};
  });
}

// ── Multi-trace chart ─────────────────────────────────────
function AT_drawMultiChart(canvasId, results, showAvg, ranges){
  const canvas=document.getElementById(canvasId); if(!canvas)return;
  const dpr=window.devicePixelRatio||1, W=canvas.clientWidth, H=canvas.clientHeight;
  canvas.width=W*dpr; canvas.height=H*dpr;
  const ctx=canvas.getContext('2d'); ctx.scale(dpr,dpr);
  const PAD={l:62,r:18,t:20,b:42}, PW=W-PAD.l-PAD.r, PH=H-PAD.t-PAD.b;

  const maxH=Math.max(...results.map(r=>r.totalH));
  const minT=0, maxT=maxH;

  const normTraces=results.map(r=>{
    const sm=smth(r.vals,15);
    const mn=Math.min(...sm), mx=Math.max(...sm), rng=mx-mn||1;
    return{times:r.times, vals:sm.map(v=>(v-mn)/rng), peaks:r.peaks, troughs:r.troughs};
  });

  const nPts=400;
  const tAxis=Array.from({length:nPts},(_,i)=>minT+i/(nPts-1)*(maxT-minT));

  function interp(times,vals,t){
    if(t<=times[0]) return vals[0];
    if(t>=times[times.length-1]) return vals[vals.length-1];
    let lo=0,hi=times.length-1;
    while(hi-lo>1){const mid=(lo+hi)>>1;times[mid]<=t?lo=mid:hi=mid;}
    const frac=(t-times[lo])/(times[hi]-times[lo]);
    return vals[lo]+frac*(vals[hi]-vals[lo]);
  }

  const matrix=normTraces.map(tr=>tAxis.map(t=>interp(tr.times,tr.vals,t)));
  const meanV=tAxis.map((_,i)=>{const col=matrix.map(r=>r[i]);return col.reduce((a,b)=>a+b,0)/col.length});
  const sdV=tAxis.map((_,i)=>{const col=matrix.map(r=>r[i]);const m=col.reduce((a,b)=>a+b,0)/col.length;return Math.sqrt(col.reduce((s,v)=>s+(v-m)**2,0)/Math.max(1,col.length-1));});

  const vLo=-0.06, vHi=1.1;
  const cx=t=>PAD.l+Math.max(0,Math.min(PW,(t-minT)/(maxT-minT)*PW));
  const cy=v=>PAD.t+(1-(v-vLo)/(vHi-vLo))*PH;

  // Background
  ctx.fillStyle='#1c2738'; ctx.fillRect(0,0,W,H);

  // ── Range bands ──────────────────────────────────────────
  if(ranges && ranges.length){
    ranges.forEach((rng,ri)=>{
      const x0=cx(Math.max(rng.from,minT));
      const x1=cx(Math.min(rng.to,  maxT));
      if(x1<=x0) return;
      // Fill band
      ctx.fillStyle=rng.colour;
      ctx.fillRect(x0,PAD.t,x1-x0,PH);
      // Left boundary
      ctx.strokeStyle=rng.colour.replace(/[\d.]+\)$/,'0.5)');
      ctx.lineWidth=1; ctx.setLineDash([4,3]);
      ctx.beginPath(); ctx.moveTo(x0,PAD.t); ctx.lineTo(x0,PAD.t+PH); ctx.stroke();
      // Right boundary
      ctx.beginPath(); ctx.moveTo(x1,PAD.t); ctx.lineTo(x1,PAD.t+PH); ctx.stroke();
      ctx.setLineDash([]);
      // Label at top of band
      const label=rng.label||`Range ${ri+1}`;
      ctx.font=`9px 'DM Mono',monospace`; ctx.textAlign='left';
      ctx.fillStyle=rng.colour.replace(/[\d.]+\)$/,'0.9)');
      ctx.fillText(label.slice(0,18), x0+4, PAD.t+11);
    });
  }

  // Grid — every 24 h
  ctx.strokeStyle='rgba(255,255,255,0.05)'; ctx.lineWidth=0.5; ctx.setLineDash([3,4]);
  ctx.fillStyle='#415566'; ctx.font=`10px 'DM Mono',monospace`; ctx.textAlign='center';
  for(let t=0;t<=maxT;t+=24){
    const x=cx(t);
    ctx.beginPath(); ctx.moveTo(x,PAD.t); ctx.lineTo(x,PAD.t+PH); ctx.stroke();
    ctx.fillText(t+'h',x,PAD.t+PH+24);
  }
  ctx.setLineDash([]);

  // Y ticks
  ['0','0.5','1'].forEach((lbl,i)=>{
    const v=[0,0.5,1][i], y=cy(v);
    ctx.strokeStyle='rgba(255,255,255,0.04)'; ctx.lineWidth=0.5;
    ctx.beginPath(); ctx.moveTo(PAD.l,y); ctx.lineTo(PAD.l+PW,y); ctx.stroke();
    ctx.fillStyle='#415566'; ctx.textAlign='right'; ctx.font=`10px 'DM Mono',monospace`;
    ctx.fillText(lbl,PAD.l-5,y+3);
  });

  // Axes
  ctx.strokeStyle='rgba(255,255,255,0.15)'; ctx.lineWidth=1;
  ctx.beginPath(); ctx.moveTo(PAD.l,PAD.t); ctx.lineTo(PAD.l,PAD.t+PH); ctx.lineTo(PAD.l+PW,PAD.t+PH); ctx.stroke();

  // SD envelope
  if(showAvg && results.length>1){
    ctx.beginPath();
    tAxis.forEach((t,i)=>{const y=cy(meanV[i]+sdV[i]);i===0?ctx.moveTo(cx(t),y):ctx.lineTo(cx(t),y);});
    tAxis.slice().reverse().forEach((t,i)=>{const ri=tAxis.length-1-i;ctx.lineTo(cx(t),cy(meanV[ri]-sdV[ri]));});
    ctx.closePath(); ctx.fillStyle='rgba(96,165,250,0.12)'; ctx.fill();
  }

  // Individual traces
  const traceAlpha=showAvg&&results.length>1?0.45:1;
  normTraces.forEach((tr,idx)=>{
    const col=AT_PAL[idx%AT_PAL.length];
    ctx.beginPath();
    ctx.strokeStyle=col+(traceAlpha<1?Math.round(traceAlpha*255).toString(16).padStart(2,'0'):'');
    ctx.lineWidth=traceAlpha<1?1.2:1.8; ctx.lineJoin='round';
    tr.times.forEach((t,i)=>i===0?ctx.moveTo(cx(t),cy(tr.vals[i])):ctx.lineTo(cx(t),cy(tr.vals[i])));
    ctx.stroke();
    if(!showAvg||results.length===1){
      tr.peaks.forEach(p=>{
        const sv=interp(tr.times,tr.vals,p.t);
        const x=cx(p.t),y=cy(sv),s=6;
        ctx.beginPath();ctx.moveTo(x,y-s);ctx.lineTo(x+s,y+s*.65);ctx.lineTo(x-s,y+s*.65);ctx.closePath();
        ctx.fillStyle='#f97316';ctx.fill();
      });
      tr.troughs.forEach(p=>{
        const sv=interp(tr.times,tr.vals,p.t);
        const x=cx(p.t),y=cy(sv),s=5;
        ctx.beginPath();ctx.moveTo(x,y-s);ctx.lineTo(x+s,y);ctx.lineTo(x,y+s);ctx.lineTo(x-s,y);ctx.closePath();
        ctx.fillStyle='#34d399';ctx.fill();
      });
    }
  });

  // Mean trace
  if(showAvg && results.length>1){
    ctx.beginPath(); ctx.strokeStyle='#ffffff'; ctx.lineWidth=2; ctx.lineJoin='round';
    tAxis.forEach((t,i)=>i===0?ctx.moveTo(cx(t),cy(meanV[i])):ctx.lineTo(cx(t),cy(meanV[i])));
    ctx.stroke();
  }

  // Legend
  ctx.font=`9px 'DM Mono',monospace`; ctx.textAlign='left';
  const short=n=>n.replace(/\.[^.]+$/,'').slice(0,18);
  results.forEach((r,i)=>{
    const col=AT_PAL[i%AT_PAL.length];
    const lx=PAD.l+4+(i%4)*(PW/4), ly=PAD.t+PH+33;
    ctx.fillStyle=col; ctx.fillRect(lx,ly-6,18,2);
    ctx.fillStyle='#6a8aaa'; ctx.fillText(short(r.filename||`File ${i+1}`),lx+22,ly);
  });
  if(showAvg&&results.length>1){
    ctx.fillStyle='rgba(255,255,255,0.8)'; ctx.fillRect(PAD.l+4,PAD.t+PH+39,18,2);
    ctx.fillStyle='#6a8aaa'; ctx.fillText('Mean',PAD.l+26,PAD.t+PH+44);
  }

  // Axis labels
  ctx.fillStyle='#415566'; ctx.font=`10px 'DM Mono',monospace`; ctx.textAlign='center';
  ctx.fillText('Elapsed time (h)',PAD.l+PW/2,H-4);
  ctx.save(); ctx.translate(13,PAD.t+PH/2); ctx.rotate(-Math.PI/2);
  ctx.fillText('Normalised signal',0,0); ctx.restore();
}

// ── Render ────────────────────────────────────────────────
function AT_render(results, ctRaws, anchorMode, ranges){
  const right=document.getElementById('AT-right');
  const showAvg=document.getElementById('AT-avg').checked;
  const nFiles=results.length;
  const meanPeriod=results.reduce((s,r)=>s+r.period,0)/nFiles;
  const meanDur=results.reduce((s,r)=>s+r.totalH,0)/nFiles;
  const anchorLabel=anchorMode==='trough'?'Trough (first trough)':'Peak (first peak)';
  const nRanges=results[0].rangeResults.length;
  const peakCT=AT_getCassette();           // null = no annotation
  const cassetteName=AT_getCassetteName();
  const hasCassette=peakCT!==null;

  // ── Per-range result blocks ──────────────────────────────
  function rangeBlocks(){
    return results[0].rangeResults.map((rr,ri)=>{
      const rngLabel=rr.label;
      const rngColour=rr.colour;
      const optData=AT_computeOptimum(results,ctRaws,ri,peakCT);

      // Absolute cards — one per treatment, rows per file
      const absHtml=ctRaws.map(raw=>{
        const {offset,label,noCassette}=AT_parseCT(raw,peakCT);
        const colour=AT_col(offset,meanPeriod);
        const ctLabel=AT_offsetToCtLabel(offset,peakCT,meanPeriod);
        const fileRows=results.map((r,i)=>{
          const rngRes=r.rangeResults[ri];
          const t=rngRes?.treatments.find(x=>x.label===label);
          if(!t) return '';
          const col=AT_PAL[i%AT_PAL.length];
          const fname=(r.filename||`File ${i+1}`).replace(/\.[^.]+$/,'').slice(0,16);
          return `<div style="display:flex;align-items:center;gap:7px;padding:3px 0;border-bottom:1px solid var(--border)">
            <span style="width:8px;height:8px;border-radius:50%;background:${col};flex-shrink:0;display:inline-block"></span>
            <span style="font-size:10px;color:var(--text3);min-width:80px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap" title="${esc(r.filename||'')}"> ${esc(fname)}</span>
            <span style="font-family:var(--fm);font-size:12px;color:var(--text);margin-left:auto">${ft(t.clock)}</span>
            <span style="font-size:10px;color:var(--text3)">${fd(t.clock)}</span>
          </div>`;
        }).join('');
        return `<div style="background:var(--bg3);border:1px solid var(--border);border-left:3px solid ${colour};border-radius:4px;padding:10px 12px">
          <div style="display:flex;align-items:center;gap:8px;flex-wrap:wrap;margin-bottom:2px">
            <span style="font-family:var(--fm);font-size:20px;font-weight:700;color:${colour}">${esc(label)}</span>
            ${hasCassette?`<span style="font-family:var(--fm);font-size:13px;color:${colour};opacity:0.8">${ctLabel}</span>`:''}
          </div>
          <div style="font-size:10px;color:var(--text3);margin-bottom:6px">${AT_phase(offset,meanPeriod)}</div>
          ${fileRows}
        </div>`;
      }).join('');

      // Optimum cards
      const optHtml=optData.filter(Boolean).map(o=>{
