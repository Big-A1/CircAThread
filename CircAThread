  const meanPeriod=AT_results.reduce((s,r)=>s+r.period,0)/AT_results.length;
  const anchorMode=AT_getAnchor();
  const nRanges=AT_results[0].rangeResults.length;

  const lines=[
    'CIRCATREAT — CIRCADIAN TREATMENT TIME PREDICTOR',
    `Generated: ${new Date().toLocaleString('en-GB')}`,
