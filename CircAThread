// ── CSV Auto-detection and peak/trough extraction ─────────
// range: {from, to} in hours, or null for full recording
// anchorMode: 'peak' | 'trough'
function TR_extractFromLumiCSV(text, fname, range, anchorMode){
  let pairs;
  try { pairs = parseCSV(text, fname); }
  catch(e){ throw new Error(fname+': '+e.message); }

  if(!pairs||pairs.length<10) throw new Error(fname+': not enough data points');

  // Slice to range if specified
  if(range){
    pairs = pairs.filter(p=>p[0]>=range.from && p[0]<=range.to);
    if(pairs.length<10) throw new Error(fname+`: range h${range.from}–h${range.to} contains too few points`);
  }

  const times = pairs.map(p=>p[0]);
  const vals  = pairs.map(p=>p[1]);

  // Smooth and detect peaks/troughs
  const sm = smth(vals, 11);
  const W  = 5;
  const peaks=[], troughs=[];

  for(let i=W; i<sm.length-W; i++){
    let ip=true, it=true;
    for(let j=i-W; j<=i+W; j++){
      if(j===i) continue;
      if(sm[i]<sm[j]) ip=false;
      if(sm[i]>sm[j]) it=false;
    }
    if(ip) peaks.push({x: parseFloat((times[i]/24).toFixed(5)), y: parseFloat(vals[i].toFixed(3))});
    if(it) troughs.push({x: parseFloat((times[i]/24).toFixed(5)), y: parseFloat(vals[i].toFixed(3))});
  }

  if(peaks.length<2) throw new Error(fname+': fewer than 2 peaks detected — need at least 2 cycles.');

  const {type: _st, idx: _si} = (typeof TR_parseStart === 'function') ? TR_parseStart() : {type:'pk', idx:0};
  const usePeaks   = peaks.slice(_st==='pk' ? _si : 0);
  const useTroughs = troughs.slice(_st==='tr' ? _si : 0);
  const peakXh   = usePeaks.map(p=>p.x*24);
  const troughXh = useTroughs.map(t=>t.x*24);

  let period = NaN;
  if(peakXh.length>=2){
    const ivs=peakXh.slice(1).map((v,i)=>v-peakXh[i]).filter(v=>v>=16&&v<=36);
    if(ivs.length) period = ivs.reduce((a,b)=>a+b)/ivs.length;
  }

  // Phase: position of first anchor feature within one cycle (0 – period h).
  // Calculated as elapsed_time % period — i.e. the acrophase in hours,
  // independent of how many cycles elapsed before the first detected feature.
  // Falls back to raw elapsed time if period could not be determined.
  const rawPhaseH = anchorMode==='trough'
    ? (troughXh[0] !== undefined ? troughXh[0] : NaN)
    : (peakXh[0]   !== undefined ? peakXh[0]   : NaN);
  const phase = (!isNaN(rawPhaseH) && !isNaN(period))
    ? ((rawPhaseH % period) + period) % period   // modulo, always positive
    : rawPhaseH;

  const magnitude  = usePeaks.length ? usePeaks.reduce((s,p)=>s+p.y,0)/usePeaks.length : NaN;

  // Shared arrays used by amplitude, rising, and falling calculations
  const allPeakXh   = peaks.map(p=>p.x*24);
  const allTroughXh = troughs.map(t=>t.x*24);

  // ── Amplitude (peak-to-trough, cycle-matched) ────────────
  // For each consecutive peak pair whose inter-peak interval is 16–36 h,
  // find the deepest trough between them (same triplets as rising/falling).
  // Amplitude for that cycle = peak_i.y − trough.y  (always positive).
  // Mean across all valid cycles is reported.

  const amplitudeIntervals = [];
  for(let i=0; i<allPeakXh.length-1; i++){
    const pk0t = allPeakXh[i];
    const pk1t = allPeakXh[i+1];
    if(pk1t - pk0t < 16 || pk1t - pk0t > 36) continue;
    const candidateTrs = allTroughXh.filter(t => t > pk0t && t < pk1t);
    if(!candidateTrs.length) continue;
    // deepest trough
    const deepestTr = troughs
      .filter(t => t.x*24 > pk0t && t.x*24 < pk1t)
      .reduce((a,b) => b.y < a.y ? b : a);
    const pk0y = peaks[i].y;
    const amp  = pk0y - deepestTr.y;
    if(amp > 0) amplitudeIntervals.push(amp);
  }
  const amplitude = amplitudeIntervals.length
    ? amplitudeIntervals.reduce((a,b)=>a+b,0)/amplitudeIntervals.length : NaN;

  // ── Rising & Falling period (cycle-matched) ─────────────

  const risingIntervals  = [];
  const fallingIntervals = [];

  for(let i=0; i<allPeakXh.length-1; i++){
    const pk0 = allPeakXh[i];
    const pk1 = allPeakXh[i+1];
    const cycleLen = pk1 - pk0;
    if(cycleLen < 16 || cycleLen > 36) continue;   // implausible cycle, skip

    // Find the trough that lies strictly between pk0 and pk1
    // If multiple troughs exist in this window, take the lowest (deepest)
    const candidateTrs = allTroughXh.filter(t => t > pk0 && t < pk1);
    if(!candidateTrs.length) continue;              // no trough detected — skip
    const trT = candidateTrs.reduce((a,b)=>{
      // pick the one with the lowest y value (deepest trough)
      const ay = troughs.find(t=>Math.abs(t.x*24-a)<0.001)?.y ?? Infinity;
      const by = troughs.find(t=>Math.abs(t.x*24-b)<0.001)?.y ?? Infinity;
      return ay < by ? a : b;
    });

    const falling = trT - pk0;
    const rising  = pk1 - trT;

    // Sanity: both limbs must be positive and together equal cycleLen
    if(falling > 0 && rising > 0){
      fallingIntervals.push(falling);
      risingIntervals.push(rising);
    }
  }

  const risingPeriod  = risingIntervals.length
    ? risingIntervals.reduce((a,b)=>a+b,0)/risingIntervals.length : NaN;
  const fallingPeriod = fallingIntervals.length
    ? fallingIntervals.reduce((a,b)=>a+b,0)/fallingIntervals.length : NaN;

  return { peaks, troughs, period, phase, amplitude, magnitude, risingPeriod, fallingPeriod };
}

