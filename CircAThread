  });

  // ── Average ± SEM trace ──────────────────────────────────────────
  const doAvg = document.getElementById('AC-avg')?.checked;
  if(doAvg && proc.length >= 2){
    const globalMinT=Math.min(...proc.map(t=>t.times[0]));
    const globalMaxT=Math.max(...proc.map(t=>t.times[t.times.length-1]));
    const nGrid=400;
    const gridT=Array.from({length:nGrid},(_,i)=>globalMinT+i/(nGrid-1)*(globalMaxT-globalMinT));
    function interp(times,vals,t){
      if(t<=times[0])return vals[0];if(t>=times[times.length-1])return vals[vals.length-1];
