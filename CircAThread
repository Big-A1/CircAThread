════════════════════════════════════════════════════════════ */

// ── State ─────────────────────────────────────────────────
let AT_tc      = 0;
let AT_results = [];
let AT_files   = [];
let AT_lastCtRaws = [];

const AT_PAL = ['#60a5fa','#f97316','#34d399','#a78bfa','#fb7185','#fbbf24','#22d3ee','#e879f9'];

// ── Treatment time rows ───────────────────────────────────
AT_addRow('CT0'); AT_addRow('CT12'); AT_addRow('CT20');

function AT_addRow(val=''){
  AT_tc++;
  const row=document.createElement('div'); row.className='treat-row';
  row.innerHTML=`<span class="treat-lbl">Treatment ${AT_tc}</span><input type="text" placeholder="e.g. CT0, CT12, CT20" value="${val}"><button class="treat-rm">×</button>`;
  row.querySelector('.treat-rm').onclick=()=>{row.remove(); AT_renum()};
  document.getElementById('AT-tl').appendChild(row);
}
function AT_renum(){
  document.querySelectorAll('#AT-tl .treat-row').forEach((r,i)=>r.querySelector('.treat-lbl').textContent=`Treatment ${i+1}`);
}
document.getElementById('AT-add').onclick=()=>AT_addRow();

function AT_getAnchor(){ return 'peak'; }  // CircATreat always anchors to peak

// ── File loading ──────────────────────────────────────────
const AT_dz=document.getElementById('AT-dz');
AT_dz.addEventListener('dragover',e=>{e.preventDefault();AT_dz.classList.add('over')});
AT_dz.addEventListener('dragleave',()=>AT_dz.classList.remove('over'));
AT_dz.addEventListener('drop',e=>{
  e.preventDefault(); AT_dz.classList.remove('over');
  if(e.dataTransfer.files.length) AT_loadFiles(Array.from(e.dataTransfer.files));
});
document.getElementById('AT-fi').addEventListener('change',e=>{
  if(e.target.files.length) AT_loadFiles(Array.from(e.target.files));
  e.target.value='';
});

function AT_loadFiles(files){
  const csvs=files.filter(f=>/\.(csv|txt)$/i.test(f.name));
  if(!csvs.length){AT_st('No CSV/TXT files found.','err');return;}
  let done=0;
  csvs.forEach(f=>{
    const reader=new FileReader();
    reader.onload=ev=>{
      // Avoid exact-name duplicates
      if(!AT_files.find(x=>x.name===f.name)){
        AT_files.push({name:f.name, csv:ev.target.result, rsISO:'2026-03-30T08:00'});
        SHARED_add(f.name, ev.target.result);
      }
      done++;
      if(done===csvs.length){ AT_renderFileList(); AT_st(`${AT_files.length} file(s) loaded — click Analyse.`,''); }
    };
    reader.readAsText(f);
  });
}

