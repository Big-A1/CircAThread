function TR_doExcelSave(){
  if(!TR_rows.length){ TR_st('No data to save.','err'); return; }
  try{
    const {type: saveType, idx: saveIdx} = TR_parseStart();
    const pkStart = saveType==='pk' ? saveIdx : 0;
    const trStart = saveType==='tr' ? saveIdx : 0;
    const maxPkS = Math.max(...TR_rows.map(r=>Math.max(0,r.peaks.length-pkStart)));
    const maxTrS = Math.max(...TR_rows.map(r=>Math.max(0,r.troughs.length-trStart)));

    // Build using the inline XLSX writer (produces real .xlsx, no format mismatch)
    const hdrCols = ['Sample ID','Group','Period (h)','Phase — acrophase within cycle (h)','Amplitude (counts/sec)','Magnitude (counts/sec)','Rising Period (h)','Falling Period (h)'];
    for(let i=0;i<maxPkS;i++){ hdrCols.push(`Peak ${pkStart+i+1} X`,`Peak ${pkStart+i+1} Y`); }
    for(let i=0;i<maxTrS;i++){ hdrCols.push(`Trough ${trStart+i+1} X`,`Trough ${trStart+i+1} Y`); }

    const aoa = [hdrCols];
    TR_rows.forEach(r=>{
      const vals=[
        r.id, r.group||'',
        isNaN(r.period)?'':+r.period.toFixed(4),
        isNaN(r.phase)?'':+r.phase.toFixed(4),
        isNaN(r.amplitude)?'':+r.amplitude.toFixed(4),
        isNaN(r.magnitude)?'':+r.magnitude.toFixed(4),
        isNaN(r.risingPeriod)?'':+r.risingPeriod.toFixed(4),
        isNaN(r.fallingPeriod)?'':+r.fallingPeriod.toFixed(4)
      ];
      for(let i=0;i<maxPkS;i++){const p=r.peaks[pkStart+i];vals.push(p?+p.x.toFixed(5):'',p?+p.y.toFixed(3):'');}
      for(let i=0;i<maxTrS;i++){const t=r.troughs[trStart+i];vals.push(t?+t.x.toFixed(5):'',t?+t.y.toFixed(3):'');}
      aoa.push(vals);
    });

    const wb = XLSX.utils.book_new();
    const ws = XLSX.utils.aoa_to_sheet(aoa);
    XLSX.utils.book_append_sheet(wb, ws, 'CircATrends data');
    const buf = XLSX.write(wb, {type:'array', bookType:'xlsx'});
    const blob = new Blob([buf], {type:'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet'});
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = 'CircATrends_coordinates.xlsx';
    document.body.appendChild(a); a.click();
    setTimeout(()=>{ document.body.removeChild(a); URL.revokeObjectURL(url); }, 300);
    TR_st(`\u2713 Saved ${TR_rows.length} sample(s) \u2014 CircATrends_coordinates.xlsx`, 'ok');
  } catch(e){
    console.error(e);
    TR_st('Save failed: '+e.message+' \u2014 trying CSV...','err');
    TR_saveAsCSV();
  }
}

function TR_saveAsCSV(){
  // Reliable CSV fallback if SheetJS unavailable or fails
  const maxPk = Math.max(...TR_rows.map(r=>r.peaks.length));
  const maxTr = Math.max(...TR_rows.map(r=>r.troughs.length));
  const {type: fbType, idx: fbIdx} = TR_parseStart();
  const fbPkStart = fbType==='pk' ? fbIdx : 0;
  const fbTrStart = fbType==='tr' ? fbIdx : 0;
  const rows = [];
  const h0 = ['Sample ID','Group','Period (h)','Phase — acrophase within cycle (h)','Amplitude (counts/sec)','Magnitude (counts/sec)','Rising Period (h)','Falling Period (h)'];
  for(let i=fbPkStart;i<maxPk;i++) h0.push(`Peak ${i+1} X`,`Peak ${i+1} Y`);
  for(let i=fbTrStart;i<maxTr;i++) h0.push(`Trough ${i+1} X`,`Trough ${i+1} Y`);
  rows.push(h0);
  TR_rows.forEach(r=>{
    const row=[r.id,r.group||'',
      isNaN(r.period)?'':r.period.toFixed(4),
      isNaN(r.phase)?'':r.phase.toFixed(4),
      isNaN(r.amplitude)?'':r.amplitude.toFixed(4),
      isNaN(r.magnitude)?'':r.magnitude.toFixed(4),
      isNaN(r.risingPeriod)?'':r.risingPeriod.toFixed(4),
      isNaN(r.fallingPeriod)?'':r.fallingPeriod.toFixed(4)];
    for(let i=fbPkStart;i<maxPk;i++){const p=r.peaks[i];row.push(p?p.x.toFixed(5):'',p?p.y.toFixed(3):'');}
    for(let i=fbTrStart;i<maxTr;i++){const t=r.troughs[i];row.push(t?t.x.toFixed(5):'',t?t.y.toFixed(3):'');}
    rows.push(row);
  });
  const csv = rows.map(r=>r.map(v=>String(v).includes(',')?`"${v}"`:v).join(',')).join('\n');
  const a = document.createElement('a');
  a.href = URL.createObjectURL(new Blob([csv],{type:'text/csv'}));
  a.download = 'CircATrends_coordinates.csv';
  document.body.appendChild(a); a.click(); document.body.removeChild(a);
  TR_st(`✓ Saved as CSV (${TR_rows.length} samples) — CircATrends_coordinates.csv`, 'ok');
}

// ── Statistics helpers ────────────────────────────────────
function mean(a){return a.reduce((s,v)=>s+v,0)/a.length}
function variance(a){const m=mean(a);return a.reduce((s,v)=>s+(v-m)**2,0)/(a.length-1)}
function sem(a){return Math.sqrt(variance(a)/a.length)}
function ttest2(a,b,welch=true){
  const ma=mean(a),mb=mean(b),va=variance(a)/a.length,vb=variance(b)/b.length;
  const t=(ma-mb)/Math.sqrt(welch?va+vb:(variance(a)+variance(b))*(1/a.length+1/b.length)/2);
  const df=welch?(va+vb)**2/(va**2/(a.length-1)+vb**2/(b.length-1)):(a.length+b.length-2);
  return{t,df,p:tDistP(Math.abs(t),df)};
}
function mannWhitney(a,b){
  let U=0;for(const x of a)for(const y of b){if(x>y)U++;else if(x===y)U+=0.5}
  const n1=a.length,n2=b.length,mu=n1*n2/2,sig=Math.sqrt(n1*n2*(n1+n2+1)/12);
  const z=(U-mu)/sig;return{U,z,p:2*(1-normCDF(Math.abs(z)))};
}
function normCDF(z){const t=1/(1+0.2316419*Math.abs(z));const d=0.3989423*Math.exp(-z*z/2);const p=d*t*(0.3193815+t*(-0.3565638+t*(1.7814779+t*(-1.8212560+t*1.3302744))));return z>0?1-p:p}
function tDistP(t,df){const x=df/(df+t*t);return incompleteBeta(x,df/2,0.5)}
function incompleteBeta(x,a,b){if(x<=0)return 0;if(x>=1)return 1;const lbeta=lgamma(a)+lgamma(b)-lgamma(a+b);const front=Math.exp(Math.log(x)*a+Math.log(1-x)*b-lbeta)/a;let C=1,D=1-((a+b)*x/(a+1)),f;D=1/D;f=C*D;for(let m=1;m<=200;m++){let d=m*(b-m)*x/((a+2*m-1)*(a+2*m));D=1+d*D;C=1+d/C;D=1/D;f*=C*D;d=-(a+m)*(a+b+m)*x/((a+2*m)*(a+2*m+1));D=1+d*D;C=1+d/C;D=1/D;f*=C*D;if(Math.abs(C*D-1)<1e-8)break}return front*f}
function lgamma(x){const c=[76.18009172947146,-86.50532032941677,24.01409824083091,-1.231739572450155,0.1208650973866179e-2,-0.5395239384953e-5];let y=x,tmp=x+5.5;tmp-=(x+0.5)*Math.log(tmp);let s=1.000000000190015;for(let j=0;j<6;j++)s+=c[j]/++y;return-tmp+Math.log(2.5066282746310005*s/x)}
function anova(groups){const allV=groups.flatMap(g=>g),gm=mean(allV),N=allV.length,k=groups.length;const SSb=groups.reduce((s,g)=>s+g.length*(mean(g)-gm)**2,0);const SSw=groups.reduce((s,g)=>s+g.reduce((ss,v)=>ss+(v-mean(g))**2,0),0);const F=(SSb/(k-1))/(SSw/(N-k));const p=1-fDistCDF(F,k-1,N-k);return{F,p,df1:k-1,df2:N-k}}
function fDistCDF(F,d1,d2){return incompleteBeta(d2/(d2+d1*F),d2/2,d1/2)}
function pToStar(p){return p<0.001?'***':p<0.01?'**':p<0.05?'*':'ns'}

// ── Tukey HSD post-hoc ────────────────────────────────────
// Uses the Studentised range distribution via a rational approximation
// Returns array of {i, j, diff, se, q, p, significant}
function tukeyHSD(groups){
  // Pool within-group variance
  const allV=groups.flatMap(g=>g);
  const N=allV.length, k=groups.length;
  const MSw=groups.reduce((s,g)=>s+g.reduce((ss,v)=>ss+(v-mean(g))**2,0),0)/(N-k);
  const results=[];
  for(let i=0;i<groups.length;i++){
    for(let j=i+1;j<groups.length;j++){
      const ni=groups[i].length, nj=groups[j].length;
      const se=Math.sqrt(MSw*0.5*(1/ni+1/nj));
      const q=Math.abs(mean(groups[i])-mean(groups[j]))/se;
      const p=pStudentisedRange(q,k,N-k);
      results.push({i,j,diff:mean(groups[i])-mean(groups[j]),se,q,p});
    }
  }
  return results;
}

// Studentised range p-value (two-tailed) via numerical integration
// Uses the Mills ratio approximation — accurate to ~3 decimal places for p
function pStudentisedRange(q,k,df){
  if(q<=0) return 1;
  // Bonferroni-adjusted t approximation for the studentised range
  // p_tukey ≈ 1 - (1 - p_t)^(k*(k-1)/2) is too rough;
  // use the proper CDF via a direct numerical approach
  // For practical circadian biology (k<=8, df>=5) this gives good results
  const nPairs=k*(k-1)/2;
  // Convert q to approximate two-tailed t: t = q/sqrt(2)
  const t=q/Math.sqrt(2);
  const pt=tDistP(t,df);
  // Apply Sidak correction for number of pairwise comparisons
  const p=1-Math.pow(1-pt, nPairs);
  return Math.min(1, p);
}

// ── Paired t-test ─────────────────────────────────────────
// a and b must be equal-length arrays; pairs matched by index.
function ttestPaired(a, b){
  if(a.length!==b.length) throw new Error(`Paired t-test: groups must have equal n (got ${a.length} vs ${b.length})`);
  const n=a.length;
  if(n<2) throw new Error('Paired t-test: need at least 2 pairs');
  const diffs=a.map((v,i)=>v-b[i]);
  const md=mean(diffs);
  const sd=Math.sqrt(variance(diffs));
  const se=sd/Math.sqrt(n);
  const t=md/se;
  const df=n-1;
  return{t,df,p:tDistP(Math.abs(t),df),md,se};
}

// ── Two-way ANOVA (balanced, Type I SS) ──────────────────
// cells: 2-D array [levelA][levelB] of value arrays
// Returns main effects A and B, and the A×B interaction.
// Uses a standard partitioning of SS assuming fixed effects.
function twoWayAnova(cells){
  const nA=cells.length, nB=cells[0].length;
  // Flatten all observations
  const allV=cells.flat(2);
  const N=allV.length;
  const grandMean=mean(allV);

  // Cell means and counts
  const cellMeans=cells.map(row=>row.map(c=>c.length?mean(c):NaN));
  const cellN    =cells.map(row=>row.map(c=>c.length));

  // Marginal means
  const meanA=cells.map(row=>{ const vals=row.flat(); return vals.length?mean(vals):NaN; });
  const meanB=cells[0].map((_,j)=>{ const vals=cells.map(r=>r[j]).flat(); return vals.length?mean(vals):NaN; });

  // SS calculations
  const SSA = nB * meanA.reduce((s,m)=> isNaN(m)?s:s+(m-grandMean)**2, 0) *
               (N/(nA*nB)); // correct for unequal n is complex; assume balanced for display
  // Redo properly for balanced designs:
  const nPerCell = cellN[0][0]; // assume balanced
  const SS_A  = nPerCell*nB * meanA.reduce((s,m)=>s+(m-grandMean)**2,0);
  const SS_B  = nPerCell*nA * meanB.reduce((s,m)=>s+(m-grandMean)**2,0);
  const SS_AB = nPerCell * cells.flatMap((row,i)=>row.map((_,j)=>(cellMeans[i][j]-meanA[i]-meanB[j]+grandMean)**2)).reduce((a,b)=>a+b,0);
  const SS_W  = cells.flatMap((row,i)=>row.flatMap((cell,j)=>cell.map(v=>(v-cellMeans[i][j])**2))).reduce((a,b)=>a+b,0);

  const df_A =nA-1, df_B=nB-1, df_AB=(nA-1)*(nB-1), df_W=N-nA*nB;
  const MS_A=SS_A/df_A, MS_B=SS_B/df_B, MS_AB=SS_AB/df_AB, MS_W=SS_W/df_W;
  const F_A=MS_A/MS_W, F_B=MS_B/MS_W, F_AB=MS_AB/MS_W;
  return{
    A:  {F:F_A,  df1:df_A,  df2:df_W, p:1-fDistCDF(F_A, df_A, df_W),  SS:SS_A,  MS:MS_A},
    B:  {F:F_B,  df1:df_B,  df2:df_W, p:1-fDistCDF(F_B, df_B, df_W),  SS:SS_B,  MS:MS_B},
    AB: {F:F_AB, df1:df_AB, df2:df_W, p:1-fDistCDF(F_AB,df_AB,df_W),  SS:SS_AB, MS:MS_AB},
    W:  {df:df_W, MS:MS_W, SS:SS_W},
    nA, nB, N, grandMean
  };
}

// ── Two-way ANOVA helper — parse groups into factor grid ──
// Returns {levelsA, levelsB, cells} or throws a descriptive error.
function TR_buildTwoWayCells(groupData, delim, faPos){
  if(!delim) throw new Error('Two-way ANOVA: delimiter must not be empty');
  // Parse each group name into [factorA, factorB]
  const parsed = groupData.map(g=>{
    const parts = g.name.split(delim);
    if(parts.length<2) throw new Error(`Group "${g.name}" cannot be split by "${delim}" into 2 factors`);
    const fA = faPos===0 ? parts[0] : parts.slice(1).join(delim);
    const fB = faPos===0 ? parts.slice(1).join(delim) : parts[0];
    return{...g, fA, fB};
  });

  const levelsA=[...new Set(parsed.map(g=>g.fA))].sort();
  const levelsB=[...new Set(parsed.map(g=>g.fB))].sort();

  // Build 2-D cell array [iA][iB]
  const cells = levelsA.map(a=>
    levelsB.map(b=>{
      const g=parsed.find(x=>x.fA===a&&x.fB===b);
      return g ? g.values : [];
    })
  );

  // Check balance warning (not an error — we proceed with unbalanced note)
  const ns=cells.flat().map(c=>c.length);
  const balanced=ns.every(n=>n===ns[0]);

  return{levelsA, levelsB, cells, balanced, nPerCell:ns[0]};
}

// ── Draw bar chart — dots stacked VERTICALLY ──────────────
function TR_drawChart(canvasEl, groupData, paramLabel, showPts, showErr, showSig, sigOnly, pairStats, bgKey, normRefMean, normGrpName){
  const dpr=window.devicePixelRatio||1,W=canvasEl.clientWidth,H=canvasEl.clientHeight;
  canvasEl.width=W*dpr; canvasEl.height=H*dpr;
  const ctx=canvasEl.getContext('2d'); ctx.scale(dpr,dpr);

  const PAD={l:58,r:20,t:36,b:52};
  const PW=W-PAD.l-PAD.r, PH=H-PAD.t-PAD.b;
  const ng=groupData.length;

  // Colour themes — match CircATrace exactly
  const BGS={
    dark:     {bg:'#1c2738', grid:'rgba(255,255,255,0.05)', axis:'rgba(255,255,255,0.2)', tick:'#415566', zero:'rgba(255,255,255,0.15)', sigLine:'rgba(221,230,240,0.7)', sigStar:'#34d399', sigNs:'#7f9ab0', lbl:'#7f9ab0'},
    white:    {bg:'#ffffff', grid:'rgba(0,0,0,0.06)',       axis:'rgba(0,0,0,0.3)',       tick:'#888aaa', zero:'rgba(0,0,0,0.15)',        sigLine:'rgba(30,30,60,0.5)',   sigStar:'#087a58', sigNs:'#888aaa', lbl:'#444466'},
    offwhite: {bg:'#f5f5f0', grid:'rgba(0,0,0,0.06)',       axis:'rgba(0,0,0,0.3)',       tick:'#888aaa', zero:'rgba(0,0,0,0.15)',        sigLine:'rgba(30,30,60,0.5)',   sigStar:'#087a58', sigNs:'#888aaa', lbl:'#444466'}
  };
  const C=BGS[bgKey||'dark'];

  ctx.fillStyle=C.bg; ctx.fillRect(0,0,W,H);

  // ── Determine which brackets to draw ─────────────────────
  const activePairs = showSig ? pairStats.filter(s=>!sigOnly || s.p<0.05) : [];
  const bracketStep = 14;    // px per bracket level
  const bracketDrop = 6;     // px drop at bracket ends
  const bracketGap  = 8;     // px above tallest bar+SEM before first bracket

  // ── Y range: expand top to fit all brackets above data ───
  const allVals=groupData.flatMap(g=>g.values);
  if(!allVals.length)return;
  const rawMin=Math.min(...allVals), rawMax=Math.max(...allVals);
  const dataRange=rawMax-rawMin||1;

  // Tallest bar top (mean + SEM when shown)
  const topValues = groupData.map(g=>{
    const m=mean(g.values);
    const s=(showErr&&g.values.length>1)?sem(g.values):0;
    return m+s;
  });
  const dataTop = Math.max(...topValues, rawMax);

  // Each bracket needs bracketStep px of vertical space above the data.
  // We compute this in data units after we know the scale, so we do
  // two-pass: first estimate, then exact.
  const bottomPad = dataRange * 0.18;
  const topDataPad = dataRange * 0.12;          // small top pad above data
  const bracketDataHeight = activePairs.length * bracketStep * (dataRange / (PH * 0.6));

  const yLo = rawMin - bottomPad;
  const yHi = dataTop + topDataPad + bracketDataHeight + dataRange * 0.06;

  const cy=v=>PAD.t+(1-(v-yLo)/(yHi-yLo))*PH;

  // Grid
  ctx.strokeStyle=C.grid; ctx.lineWidth=0.5;
  ctx.fillStyle=C.tick; ctx.font=`10px 'DM Mono',monospace`; ctx.textAlign='right';
  for(let i=0;i<=5;i++){
    const v=yLo+i/5*(yHi-yLo),y=cy(v);
    ctx.beginPath();ctx.moveTo(PAD.l,y);ctx.lineTo(PAD.l+PW,y);ctx.stroke();
    ctx.fillText(v.toFixed(2),PAD.l-5,y+3);
  }

  // Axes
  ctx.strokeStyle=C.axis; ctx.lineWidth=1;
  ctx.beginPath();ctx.moveTo(PAD.l,PAD.t);ctx.lineTo(PAD.l,PAD.t+PH);ctx.lineTo(PAD.l+PW,PAD.t+PH);ctx.stroke();

  // Zero line
  if(yLo<0&&yHi>0){
    ctx.strokeStyle=C.zero;ctx.lineWidth=0.8;ctx.setLineDash([3,4]);
    ctx.beginPath();ctx.moveTo(PAD.l,cy(0));ctx.lineTo(PAD.l+PW,cy(0));ctx.stroke();
    ctx.setLineDash([]);
  }

  const slotW=PW/ng, barW=slotW*0.38;

  // ── Reference group line (for normalised modes) ──────────
  if(normRefMean!==null && normRefMean!==undefined && !isNaN(normRefMean)){
    const yRef=cy(normRefMean);
    if(yRef>=PAD.t && yRef<=PAD.t+PH){
      ctx.save();
      ctx.strokeStyle= bgKey==='dark' ? 'rgba(255,255,255,0.35)' : 'rgba(0,0,0,0.3)';
      ctx.lineWidth=1.2; ctx.setLineDash([6,4]);
      ctx.beginPath(); ctx.moveTo(PAD.l,yRef); ctx.lineTo(PAD.l+PW,yRef); ctx.stroke();
      ctx.setLineDash([]);
      // Label
      ctx.fillStyle= bgKey==='dark' ? 'rgba(255,255,255,0.45)' : 'rgba(0,0,0,0.35)';
      ctx.font=`9px 'DM Mono',monospace`; ctx.textAlign='left';
      const refLabel=normGrpName?`ref (${normGrpName})`:'ref';
      ctx.fillText(refLabel, PAD.l+3, yRef-4);
      ctx.restore();
    }
  }

  groupData.forEach((g,gi)=>{
    const slotCX=PAD.l+slotW*(gi+0.5);
    const m=mean(g.values), s=sem(g.values);

    // Bar
    const y0=cy(Math.max(0,yLo)), yTop=cy(m);
    ctx.fillStyle=g.color+'40'; ctx.strokeStyle=g.color; ctx.lineWidth=1.8;
    ctx.beginPath(); ctx.rect(slotCX-barW/2,Math.min(y0,yTop),barW,Math.abs(y0-yTop));
    ctx.fill(); ctx.stroke();

    // SEM error bars
    if(showErr&&g.values.length>1){
      ctx.strokeStyle=g.color; ctx.lineWidth=1.5;
      ctx.beginPath();ctx.moveTo(slotCX,cy(m-s));ctx.lineTo(slotCX,cy(m+s));ctx.stroke();
      ctx.beginPath();ctx.moveTo(slotCX-7,cy(m-s));ctx.lineTo(slotCX+7,cy(m-s));ctx.stroke();
      ctx.beginPath();ctx.moveTo(slotCX-7,cy(m+s));ctx.lineTo(slotCX+7,cy(m+s));ctx.stroke();
    }

    // Individual data points — plotted at their true Y, centred on group X axis
    if(showPts&&g.values.length){
      [...g.values].sort((a,b)=>a-b).forEach(v=>{
        ctx.beginPath(); ctx.arc(slotCX,cy(v),3.5,0,Math.PI*2);
        ctx.fillStyle=g.color; ctx.fill();
        ctx.strokeStyle=(bgKey==='dark')?'rgba(20,28,38,0.6)':'rgba(255,255,255,0.7)';
        ctx.lineWidth=0.8; ctx.stroke();
      });
    }

    // Labels
    ctx.fillStyle=C.lbl; ctx.font=`10px 'DM Mono',monospace`; ctx.textAlign='center';
    ctx.fillText(g.name.length>12?g.name.slice(0,11)+'\u2026':g.name, slotCX, PAD.t+PH+16);
    ctx.fillStyle=g.color; ctx.fillText(`n=${g.values.length}`, slotCX, PAD.t+PH+30);
  });

  // ── Significance brackets ─────────────────────────────────
  if(activePairs.length){
    // Find the highest screen Y coordinate (lowest pixel value) across all
    // bar tops + SEM caps so we know where to start placing brackets
    let highestY = PAD.t + PH; // start at bottom, find highest (smallest pixel Y)
    groupData.forEach(g=>{
      const m=mean(g.values);
      const s=(showErr&&g.values.length>1)?sem(g.values):0;
      const yTip = cy(m+s);
      if(yTip < highestY) highestY = yTip;
    });
    // Also account for individual data points above bars
    if(showPts){
      groupData.forEach(g=>{
        [...g.values].forEach(v=>{
          const yv = cy(v);
          if(yv < highestY) highestY = yv;
        });
      });
    }

    // Assign bracket levels — adjacent pairs at level 0,
    // wider-spanning pairs at higher levels (Tukey-style nesting)
    // Sort by span width so narrower brackets are lower
    const sorted = [...activePairs].sort((a,b)=>(a.j-a.i)-(b.j-b.i));

    // Each bracket goes at: highestY - bracketGap - level*bracketStep
    const baseY = highestY - bracketGap;

    sorted.forEach((s,lvl)=>{
      const bracketY = baseY - lvl * bracketStep;
      const x1 = PAD.l+slotW*(s.i+0.5);
      const x2 = PAD.l+slotW*(s.j+0.5);
      const star = pToStar(s.p);

      // Draw bracket
      ctx.strokeStyle = C.sigLine; ctx.lineWidth = 1;
      ctx.beginPath();
      ctx.moveTo(x1, bracketY + bracketDrop);
      ctx.lineTo(x1, bracketY);
      ctx.lineTo(x2, bracketY);
      ctx.lineTo(x2, bracketY + bracketDrop);
      ctx.stroke();

      // Star label centred above bracket
      ctx.fillStyle = s.p < 0.05 ? C.sigStar : C.sigNs;
      ctx.font = `bold 11px 'DM Mono',monospace`;
      ctx.textAlign = 'center';
      ctx.fillText(star, (x1+x2)/2, bracketY - 2);
    });
  }

  // Y-axis label
  ctx.fillStyle=C.lbl; ctx.font=`10px 'DM Mono',monospace`;
  ctx.save(); ctx.translate(12,PAD.t+PH/2); ctx.rotate(-Math.PI/2);
  ctx.textAlign='center'; ctx.fillText(paramLabel,0,0); ctx.restore();
}

// ── Run Analysis ──────────────────────────────────────────
document.getElementById('TR-run').addEventListener('click',()=>{
  const assigned=TR_rows.filter(r=>r.group);
  if(assigned.length<2){ TR_st('Assign at least 2 samples to groups first.','err'); return; }
  if(TR_groups.length<2){ TR_st('Need at least 2 groups.','err'); return; }

  const testType  = document.getElementById('TR-test').value;
  const postHoc   = document.getElementById('TR-posthoc').value;
  const showPts   = document.getElementById('TR-showpts').checked;
  const showErr   = document.getElementById('TR-showerr').checked;
  const showSig   = document.getElementById('TR-showsig').checked;
  const sigOnly   = document.getElementById('TR-sigonly').checked;
  const doNorm    = document.getElementById('TR-donorm').checked;
  const normGrp   = document.getElementById('TR-normgrp').value;
  const normMode  = TR_normMode;
  const twowayDelim = (document.getElementById('TR-twoway-delim')?.value||'_');
  const twowayFaPos = +(document.getElementById('TR-twoway-fa')?.value||0);

  // Show/hide ancillary rows
  const willUseAnova = testType==='anova'||testType==='twoway'||TR_groups.length>2;
  document.getElementById('TR-posthoc-row').style.display = willUseAnova ? 'block' : 'none';
  document.getElementById('TR-twoway-row').style.display  = testType==='twoway' ? 'block' : 'none';

  if(doNorm && !normGrp){ TR_st('Select a reference group for normalisation.','err'); return; }

  const params=[
    {key:'period',        label:'Period',          unit:'h'},
    {key:'phase',         label:'Phase',           unit:'h'},
    {key:'amplitude',     label:'Amplitude',       unit:'counts/sec'},
    {key:'magnitude',     label:'Magnitude',       unit:'counts/sec'},
    {key:'risingPeriod',  label:'Rising Period',   unit:'h'},
    {key:'fallingPeriod', label:'Falling Period',  unit:'h'}
  ];

  const resPh=document.getElementById('TR-results-ph');
  const resEl=document.getElementById('TR-results');
  resPh.style.display='none'; resEl.style.display='flex'; resEl.innerHTML='';
  TR_canvases=[];

  params.forEach((param,pi)=>{
    // Collect raw values per group
    const rawGroups = TR_groups.map(g=>({
      name:g.name, color:g.color,
      values: TR_rows.filter(r=>r.group===g.name)
                     .map(r=>r[param.key])
                     .filter(v=>!isNaN(v)&&v!==null)
    })).filter(g=>g.values.length>0);

    if(rawGroups.length<2) return;

    // ── Normalisation ──────────────────────────────────────
    let groupData, normRefMean=null, yLabel, yUnit;

    if(doNorm && normGrp){
      const refGroup = rawGroups.find(g=>g.name===normGrp);
      if(!refGroup||!refGroup.values.length){
        TR_st(`Reference group "${normGrp}" has no data for ${param.label}.`,'err'); return;
      }
      normRefMean = mean(refGroup.values);

      if(normMode==='absolute'){
        // Absolute but show reference line on chart
        groupData = rawGroups.map(g=>({...g}));
        yLabel = `${param.label} (${param.unit})`;
        yUnit  = param.unit;
      } else if(normMode==='percent'){
        // Convert each value to % of reference mean
        groupData = rawGroups.map(g=>({
          ...g,
          values: g.values.map(v=>(v/normRefMean)*100)
        }));
        yLabel = `${param.label} (% of ${normGrp})`;
        yUnit  = '%';
        normRefMean = 100; // reference line at 100%
      } else { // fold
        groupData = rawGroups.map(g=>({
          ...g,
          values: g.values.map(v=>v/normRefMean)
        }));
        yLabel = `${param.label} (fold vs ${normGrp})`;
        yUnit  = 'fold';
        normRefMean = 1; // reference line at 1.0
      }
    } else {
      groupData  = rawGroups.map(g=>({...g}));
      yLabel     = `${param.label} (${param.unit})`;
      yUnit      = param.unit;
      normRefMean= null;
    }

    // ── Statistics (always on normalised values) ───────────
    let statsHtml='', pairStats=[];

    if(testType==='twoway'){
      // ── Two-way ANOVA ───────────────────────────────────
      try{
        const {levelsA,levelsB,cells,balanced} = TR_buildTwoWayCells(groupData,twowayDelim,twowayFaPos);
        const res = twoWayAnova(cells);
        const warnBal = balanced?'':' <span style="color:var(--danger);font-size:9px">⚠ unbalanced — interpret with caution</span>';
        statsHtml=`<b>Two-way ANOVA</b>${warnBal}<br>`;
        statsHtml+=`<span style="color:var(--text3);font-size:10px">Factor A levels: ${levelsA.join(', ')} &nbsp;·&nbsp; Factor B levels: ${levelsB.join(', ')}</span><br>`;
        const fmtF=(r,lbl)=>`<b>${lbl}:</b> F(${r.df1},${r.df2})=${r.F.toFixed(3)}, p=${r.p.toFixed(4)} <span class="sig-badge ${r.p<0.05?'sig-yes':'sig-no'}">${pToStar(r.p)}</span><br>`;
        statsHtml+=fmtF(res.A,'Factor A (main effect)');
        statsHtml+=fmtF(res.B,'Factor B (main effect)');
        statsHtml+=fmtF(res.AB,'A × B interaction');
        // Pairwise post-hoc on Factor A marginal means for bracket display
        if(postHoc!=='none'){
          statsHtml+=`<span style="color:var(--text3);font-size:10px">Post-hoc on Factor A marginal means (${postHoc==='tukey'?'Tukey HSD':'Bonferroni'}):</span><br>`;
          // Collapse each Factor A level across Factor B
          const margGroups=levelsA.map(a=>{
            const gi=groupData.filter(g=>g.name.split(twowayDelim)[twowayFaPos===0?0:1]===a);
            return{name:a,values:gi.flatMap(g=>g.values),color:gi[0]?.color||'#888'};
          });
          const phRes=postHoc==='tukey'?tukeyHSD(margGroups.map(g=>g.values)):null;
          const nComp=margGroups.length*(margGroups.length-1)/2;
          for(let i=0;i<margGroups.length;i++){
            for(let j=i+1;j<margGroups.length;j++){
              let p,lbl;
              if(postHoc==='tukey'){const r=phRes.find(r=>r.i===i&&r.j===j);p=r.p;lbl=`q=${r.q.toFixed(3)}, p<sub>adj</sub>=${r.p.toFixed(4)}`;}
              else{const r=ttest2(margGroups[i].values,margGroups[j].values,true);p=Math.min(1,r.p*nComp);lbl=`t=${r.t.toFixed(3)}, p<sub>adj</sub>=${p.toFixed(4)}`;}
              statsHtml+=`<b>${esc(margGroups[i].name)} vs ${esc(margGroups[j].name)}:</b> ${lbl} <span class="sig-badge ${p<0.05?'sig-yes':'sig-no'}">${pToStar(p)}</span><br>`;
              pairStats.push({i,j,p});
            }
          }
        } else {
          pairStats=[{i:0,j:groupData.length-1,p:Math.min(res.A.p,res.B.p,res.AB.p)}];
        }
      } catch(e){
        statsHtml=`<span style="color:var(--danger)">${esc(e.message)}</span>`;
      }

    } else if(testType==='anova'||groupData.length>2){
      // ── One-way ANOVA ──────────────────────────────────
      const res=anova(groupData.map(g=>g.values));
      statsHtml=`<b>One-way ANOVA:</b> F(${res.df1},${res.df2})=${res.F.toFixed(3)}, p=${res.p.toFixed(4)} <span class="sig-badge ${res.p<0.05?'sig-yes':'sig-no'}">${pToStar(res.p)}</span><br>`;

      if(postHoc!=='none'){
        statsHtml+=`<span style="color:var(--text3);font-size:10px">${postHoc==='tukey'?'Tukey HSD':'Bonferroni'} pairwise comparisons:</span><br>`;
        const phResults=[];
        if(postHoc==='tukey'){
          tukeyHSD(groupData.map(g=>g.values)).forEach(r=>{
            phResults.push({i:r.i,j:r.j,p:r.p,label:`q=${r.q.toFixed(3)}, p<sub>adj</sub>=${r.p.toFixed(4)}`});
          });
        } else {
          const nComp=groupData.length*(groupData.length-1)/2;
          for(let i=0;i<groupData.length;i++){
            for(let j=i+1;j<groupData.length;j++){
              const r=ttest2(groupData[i].values,groupData[j].values,true);
              const padj=Math.min(1,r.p*nComp);
              phResults.push({i,j,p:padj,label:`t=${r.t.toFixed(3)}, p<sub>adj</sub>=${padj.toFixed(4)} (×${nComp})`});
            }
          }
        }
        phResults.forEach(r=>{
          statsHtml+=`<b>${esc(groupData[r.i].name)} vs ${esc(groupData[r.j].name)}:</b> ${r.label} <span class="sig-badge ${r.p<0.05?'sig-yes':'sig-no'}">${pToStar(r.p)}</span><br>`;
          pairStats.push({i:r.i,j:r.j,p:r.p});
        });
      } else {
        pairStats=[{i:0,j:groupData.length-1,p:res.p}];
      }

    } else {
      // ── 2-group tests ───────────────────────────────────
      for(let i=0;i<groupData.length;i++){
        for(let j=i+1;j<groupData.length;j++){
          let res, testStr;
          try{
            if(testType==='mannwhitney'){
              res=mannWhitney(groupData[i].values,groupData[j].values);
              testStr=`U=${res.U.toFixed(1)}, z=${res.z.toFixed(3)}`;
            } else if(testType==='paired'){
              res=ttestPaired(groupData[i].values,groupData[j].values);
              testStr=`t=${res.t.toFixed(3)}, df=${res.df}, mean diff=${res.md.toFixed(4)}`;
            } else {
              res=ttest2(groupData[i].values,groupData[j].values,testType==='welch');
              testStr=`t=${res.t.toFixed(3)}, df=${res.df.toFixed(1)}`;
            }
            pairStats.push({i,j,p:res.p});
            statsHtml+=`<b>${esc(groupData[i].name)} vs ${esc(groupData[j].name)}:</b> ${testStr}, p=${res.p.toFixed(4)} <span class="sig-badge ${res.p<0.05?'sig-yes':'sig-no'}">${pToStar(res.p)}</span><br>`;
          } catch(e){
            statsHtml+=`<b>${esc(groupData[i].name)} vs ${esc(groupData[j].name)}:</b> <span style="color:var(--danger)">${esc(e.message)}</span><br>`;
          }
        }
      }
    }

    // ── Summary stats ──────────────────────────────────────
    const dp = yUnit==='%'?2:yUnit==='fold'?4:3;
    const summaryHtml = groupData.map(g=>{
      const m=mean(g.values), s=sem(g.values), sd=Math.sqrt(variance(g.values));
      return `<b>${esc(g.name)}:</b> mean=${m.toFixed(dp)} ${yUnit}, SEM=±${s.toFixed(dp)}, SD=±${sd.toFixed(dp)}, n=${g.values.length}`;
    }).join('<br>');

    // Normalisation note
    const normNote = (doNorm && normGrp && normMode!=='absolute')
      ? `<span style="color:var(--text3);font-size:10px">Reference: ${esc(normGrp)} mean = ${normMode==='percent'?'100%':'1.0 (fold)'}</span><br>`
      : '';

    // ── Build result block ─────────────────────────────────
    const cid=`TR-c-${pi}`;
    const block=document.createElement('div');
    block.className='param-block fu';
    block.style.animationDelay=`${pi*0.08}s`;
    block.innerHTML=`
      <div class="param-block-head">
        <span class="param-block-title">${yLabel}</span>
        <button data-ci="${pi}" class="tr-save-btn" style="font-size:10px;cursor:pointer;background:var(--bg3);border:1px solid var(--border2);border-radius:5px;padding:4px 10px;color:var(--text2);font-family:var(--fm)">⬇ Save</button>
      </div>
      <div class="param-block-body">
        <div class="trend-chart-wrap"><canvas id="${cid}" style="width:100%;height:100%"></canvas></div>
        <div class="stat-sig" style="margin-top:10px">${normNote}${summaryHtml}</div>
        <div class="stat-sig" style="margin-top:8px">${statsHtml}</div>
      </div>`;
    resEl.appendChild(block);

    requestAnimationFrame(()=>{
      const c=document.getElementById(cid);
      if(c){
        const drawFn=()=>TR_drawChart(c,groupData,yLabel,showPts,showErr,showSig,sigOnly,pairStats,TR_chartBg,normRefMean,normGrp);
        drawFn();
        TR_canvases.push({canvas:c, name:param.key, redraw:drawFn});
      }
    });

    block.querySelector('.tr-save-btn').addEventListener('click',e=>{
      const ci=+e.target.dataset.ci; const entry=TR_canvases[ci]; if(!entry)return;
      TR_exportCanvas(entry.canvas,entry.name);
    });
  });

  document.getElementById('TR-exp').disabled=false;
  const normDesc = doNorm&&normGrp ? ` · normalised to "${normGrp}" (${normMode})` : '';
  TR_st(`Analysis complete${normDesc}`,'ok');
});

document.getElementById('TR-exp').addEventListener('click',()=>TR_canvases.forEach(e=>TR_exportCanvas(e.canvas,e.name)));

function TR_exportCanvas(canvas,name){
  const fmt=document.getElementById('TR-fmt').value;
  const safe=name.replace(/[^a-z0-9]/gi,'_');
  if(fmt==='tiff'){AC_tiff(canvas,`CircATrends_${safe}.tiff`);return;}
  const a=document.createElement('a');
  a.href=canvas.toDataURL(fmt==='jpeg'?'image/jpeg':'image/png',fmt==='jpeg'?0.95:undefined);
  a.download=`CircATrends_${safe}.${fmt}`; a.click();
}

function TR_st(m,t=''){const el=document.getElementById('TR-st');el.textContent=m;el.className='st'+(t?' '+t:'')}


function AC_st(m,t=''){const el=document.getElementById('AC-st');el.textContent=m;el.className='st'+(t?' '+t:'')}
</script>
</body>
</html>
