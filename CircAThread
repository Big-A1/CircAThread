<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>CircaThread — Circadian Analysis Suite</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Source+Sans+3:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
<script>
/* CircaThread inline XLSX writer - generates valid .xlsx without CDN */
(function(){
'use strict';
function u8(s){return new TextEncoder().encode(s);}
function crc32(buf){
  var c=0xFFFFFFFF;
  var t=new Uint32Array(256);
  for(var i=0;i<256;i++){var v=i;for(var j=0;j<8;j++)v=v&1?0xEDB88320^(v>>>1):v>>>1;t[i]=v;}
  for(var i=0;i<buf.length;i++)c=t[(c^buf[i])&0xFF]^(c>>>8);
  return(c^0xFFFFFFFF)>>>0;
}
function b2(v){return[v&0xFF,(v>>8)&0xFF];}
function b4(v){return[v&0xFF,(v>>8)&0xFF,(v>>16)&0xFF,(v>>24)&0xFF];}
function cat(){
  var arrs=Array.prototype.slice.call(arguments);
  var n=arrs.reduce(function(s,a){return s+a.length;},0);
  var out=new Uint8Array(n);var off=0;
  arrs.forEach(function(a){out.set(a,off);off+=a.length;});
  return out;
}
function zip(files){
  var entries=[];var offset=0;
  files.forEach(function(f){
    var nb=u8(f.name);var crc=crc32(f.data);
    var lh=new Uint8Array([
      0x50,0x4B,0x03,0x04,0x14,0x00,0x00,0x00,0x00,0x00,
      0x00,0x00,0x00,0x00
    ].concat(b4(crc),b4(f.data.length),b4(f.data.length),b2(nb.length),[0x00,0x00]));
    entries.push({nb:nb,data:f.data,crc:crc,sz:f.data.length,off:offset,lh:lh});
    offset+=lh.length+nb.length+f.data.length;
  });
  var cdp=[];
  entries.forEach(function(e){
    cdp.push(new Uint8Array([
      0x50,0x4B,0x01,0x02,0x14,0x00,0x14,0x00,
      0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00
    ].concat(b4(e.crc),b4(e.sz),b4(e.sz),b2(e.nb.length),[0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00],b4(e.off))));
    cdp.push(e.nb);
  });
  var cd=cat.apply(null,cdp);
  var eocd=new Uint8Array([0x50,0x4B,0x05,0x06,0x00,0x00,0x00,0x00]
    .concat(b2(entries.length),b2(entries.length),b4(cd.length),b4(offset),[0x00,0x00]));
  var parts=[];
  entries.forEach(function(e){parts.push(e.lh);parts.push(e.nb);parts.push(e.data);});
  return cat.apply(null,parts.concat([cd,eocd]));
}
function xe(v){return String(v).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');}
function col(c){var s='';c++;while(c>0){s=String.fromCharCode(65+((c-1)%26))+s;c=Math.floor((c-1)/26);}return s;}
function addr(r,c){return col(c)+(r+1);}
function sheet2xml(ws,ss){
  var map={};var arr=[];
  function idx(v){if(map[v]===undefined){map[v]=arr.length;arr.push(v);}return map[v];}
  var rows='';
  var data=ws._data||[];
  data.forEach(function(row,ri){
    var cells='';
    row.forEach(function(val,ci){
      if(val===null||val===undefined||val==='')return;
      var a=addr(ri,ci);
      if(typeof val==='number'){cells+='<c r="'+a+'"><v>'+val+'</v></c>';}
      else{cells+='<c r="'+a+'" t="s"><v>'+idx(String(val))+'</v></c>';}
    });
    if(cells)rows+='<row r="'+(ri+1)+'">'+cells+'</row>';
  });
  var mg='';
  if(ws['!merges']&&ws['!merges'].length){
    var refs=ws['!merges'].map(function(m){return'<mergeCell ref="'+addr(m.s.r,m.s.c)+':'+addr(m.e.r,m.e.c)+'"/>';}).join('');
    mg='<mergeCells count="'+ws['!merges'].length+'">'+refs+'</mergeCells>';
  }
  var cols='';
  if(ws['!cols']&&ws['!cols'].length){
    var cw=ws['!cols'].map(function(c,i){return c&&c.wch?'<col min="'+(i+1)+'" max="'+(i+1)+'" width="'+c.wch+'" customWidth="1"/>':null;}).filter(Boolean).join('');
    if(cw)cols='<cols>'+cw+'</cols>';
  }
  var lr=data.length,lc=Math.max.apply(null,[0].concat(data.map(function(r){return r?r.length:0;})));
  var dim=lr&&lc?' ref="A1:'+addr(lr-1,lc-1)+'"':'';
  var xml='<?xml version="1.0" encoding="UTF-8" standalone="yes"?><worksheet xmlns="http://schemas.openxmlformats.org/spreadsheetml/2006/main"><dimension'+dim+'/>'+cols+'<sheetData>'+rows+'</sheetData>'+mg+'</worksheet>';
  ss.push.apply(ss,arr);
  return xml;
}
var utils={
  aoa_to_sheet:function(aoa){
    return{_data:aoa.map(function(row){return row.map(function(v){return v===undefined||v===null?'':v;});}),'!merges':[],'!cols':[]};
  },
  book_new:function(){return{SheetNames:[],Sheets:{}};},
  book_append_sheet:function(wb,ws,name){wb.SheetNames.push(name);wb.Sheets[name]=ws;}
};
function write(wb,opts){
  var allSS=[];
  var sheets=wb.SheetNames.map(function(name,i){
    var xml=sheet2xml(wb.Sheets[name],allSS);
    return{name:name,xml:xml};
  });
  var ssxml='<?xml version="1.0" encoding="UTF-8" standalone="yes"?><sst xmlns="http://schemas.openxmlformats.org/spreadsheetml/2006/main" count="'+allSS.length+'" uniqueCount="'+allSS.length+'">'+allSS.map(function(s){return'<si><t xml:space="preserve">'+xe(s)+'</t></si>';}).join('')+'</sst>';
  var wbxml='<?xml version="1.0" encoding="UTF-8" standalone="yes"?><workbook xmlns="http://schemas.openxmlformats.org/spreadsheetml/2006/main" xmlns:r="http://schemas.openxmlformats.org/officeDocument/2006/relationships"><sheets>'+sheets.map(function(s,i){return'<sheet name="'+xe(s.name)+'" sheetId="'+(i+1)+'" r:id="rId'+(i+2)+'"/>';}).join('')+'</sheets></workbook>';
  var wbrels='<?xml version="1.0" encoding="UTF-8" standalone="yes"?><Relationships xmlns="http://schemas.openxmlformats.org/package/2006/relationships"><Relationship Id="rId1" Type="http://schemas.openxmlformats.org/officeDocument/2006/relationships/sharedStrings" Target="sharedStrings.xml"/>'+sheets.map(function(s,i){return'<Relationship Id="rId'+(i+2)+'" Type="http://schemas.openxmlformats.org/officeDocument/2006/relationships/worksheet" Target="worksheets/sheet'+(i+1)+'.xml"/>';}).join('')+'</Relationships>';
  var ct='<?xml version="1.0" encoding="UTF-8" standalone="yes"?><Types xmlns="http://schemas.openxmlformats.org/package/2006/content-types"><Default Extension="rels" ContentType="application/vnd.openxmlformats-package.relationships+xml"/><Default Extension="xml" ContentType="application/xml"/><Override PartName="/xl/workbook.xml" ContentType="application/vnd.openxmlformats-officedocument.spreadsheetml.sheet.main+xml"/><Override PartName="/xl/sharedStrings.xml" ContentType="application/vnd.openxmlformats-officedocument.spreadsheetml.sharedStrings+xml"/>'+sheets.map(function(s,i){return'<Override PartName="/xl/worksheets/sheet'+(i+1)+'.xml" ContentType="application/vnd.openxmlformats-officedocument.spreadsheetml.worksheet+xml"/>';}).join('')+'</Types>';
  var rr='<?xml version="1.0" encoding="UTF-8" standalone="yes"?><Relationships xmlns="http://schemas.openxmlformats.org/package/2006/relationships"><Relationship Id="rId1" Type="http://schemas.openxmlformats.org/officeDocument/2006/relationships/officeDocument" Target="xl/workbook.xml"/></Relationships>';
  var files=[
    {name:'[Content_Types].xml',data:u8(ct)},
    {name:'_rels/.rels',data:u8(rr)},
    {name:'xl/workbook.xml',data:u8(wbxml)},
    {name:'xl/_rels/workbook.xml.rels',data:u8(wbrels)},
    {name:'xl/sharedStrings.xml',data:u8(ssxml)}
  ].concat(sheets.map(function(s,i){return{name:'xl/worksheets/sheet'+(i+1)+'.xml',data:u8(s.xml)};}));
  return zip(files);
}
window.XLSX={utils:utils,write:write};
})();
</script>
<style>
/* ── Design tokens ─────────────────────────────────────────
   Layout: two-column sidebar / content, sticky rule-based header
   Type:   Source Sans 3 (body) + JetBrains Mono (data/code)
   Color:  cool-white ground, single authoritative navy accent,
           per-tab hues desaturated to calibrated, not decorative
─────────────────────────────────────────────────────────── */
:root{
  /* Surfaces */
  --bg:      #f0f2f5;
  --bg2:     #ffffff;
  --bg3:     #f5f7fa;
  --bg4:     #ebeef3;
  --bg5:     #e2e6ed;
  /* Borders */
  --border:  #d0d5de;
  --border2: #b8bfcc;
  /* Text */
  --text:    #0f1923;
  --text2:   #3d4a5c;
  --text3:   #7a8799;
  /* Semantic accent hues */
  --accent:  #0052a3;   /* journal blue — CircATreat */
  --trace:   #4a3580;   /* measured violet — CircATrace */
  --trend:   #1a6b52;   /* calibrated teal — CircATrends */
  --peak:    #b03a00;   /* warm-shifted amber-red for peaks */
  --trough:  #1a6b52;
  --gold:    #7a5c00;
  --danger:  #a82828;
  --ok:      #1a6b52;
  /* Type */
  --fh:'Source Sans 3',system-ui,sans-serif;
  --fm:'JetBrains Mono',ui-monospace,monospace;
  /* Accent RGB for rgba() use */
  --accent-r:0;--accent-g:82;--accent-b:163;
}
@media(prefers-color-scheme:dark){
  :root:not([data-theme="light"]){
    --bg:#0d1117;--bg2:#161b22;--bg3:#1c2330;--bg4:#212839;--bg5:#262e40;
    --border:#2d3748;--border2:#3d4f6a;
    --text:#e4e9f0;--text2:#9daec4;--text3:#5c7290;
    --accent:#4d8fd6;--trace:#8a78d0;--trend:#3db887;
    --peak:#e0714a;--trough:#3db887;--gold:#c4a840;
    --danger:#e05050;--ok:#3db887;
    --accent-r:77;--accent-g:143;--accent-b:214;
    color-scheme:dark;
  }
}
:root[data-theme="dark"]{
  --bg:#0d1117;--bg2:#161b22;--bg3:#1c2330;--bg4:#212839;--bg5:#262e40;
  --border:#2d3748;--border2:#3d4f6a;
  --text:#e4e9f0;--text2:#9daec4;--text3:#5c7290;
  --accent:#4d8fd6;--trace:#8a78d0;--trend:#3db887;
  --peak:#e0714a;--trough:#3db887;--gold:#c4a840;
  --danger:#e05050;--ok:#3db887;
  --accent-r:77;--accent-g:143;--accent-b:214;
  color-scheme:dark;
}
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth}
body{background:var(--bg);color:var(--text);font-family:var(--fh);font-size:13.5px;line-height:1.55;min-height:100vh}

/* ── HEADER ─────────────────────────────────────────────── */
header{
  height:48px;display:flex;align-items:stretch;
  border-bottom:2px solid var(--border);
  position:sticky;top:0;z-index:300;
  background:var(--bg2);
}
.header-brand{
  display:flex;align-items:center;gap:10px;
  padding:0 1.4rem;
  border-right:1px solid var(--border);
  flex-shrink:0;
  text-decoration:none;
}
/* Circadian clock mark — SVG sine-wave motif */
.brand-icon{width:26px;height:26px;flex-shrink:0}
.brand-name{
  font-family:var(--fh);font-weight:700;font-size:14px;
  letter-spacing:.02em;text-transform:uppercase;
  color:var(--text);
}
.brand-name em{font-style:normal;color:var(--accent);font-weight:700}
.brand-tag{
  font-size:10px;color:var(--text3);margin-left:6px;
  font-weight:400;letter-spacing:.04em;
  padding:2px 7px;border:1px solid var(--border);
  border-radius:2px;display:none;
}
@media(min-width:640px){.brand-tag{display:inline-block}}

/* ── TAB NAV ────────────────────────────────────────────── */
.tab-nav{display:flex;align-items:stretch;gap:0;padding:0 .5rem;flex:1}
.tab-btn{
  display:flex;align-items:center;gap:5px;
  height:100%;padding:0 1.1rem;
  border:none;background:transparent;
  font-family:var(--fh);font-size:12.5px;font-weight:600;
  letter-spacing:.01em;
  color:var(--text3);cursor:pointer;
  border-bottom:3px solid transparent;
  transition:color .12s,border-color .12s;
  white-space:nowrap;
}
.tab-btn:hover{color:var(--text2)}
.tab-btn.active-treat{color:var(--accent);border-bottom-color:var(--accent)}
.tab-btn.active-trace{color:var(--trace);border-bottom-color:var(--trace)}
.tab-btn.active-trend{color:var(--trend);border-bottom-color:var(--trend)}
.tab-pill{display:none}

.header-right{margin-left:auto;display:flex;align-items:center;padding-right:1.4rem;gap:12px}
.hcopyright{font-size:11px;color:var(--text3);letter-spacing:.02em}

/* ── TAB PANELS ─────────────────────────────────────────── */
.tab-panel{display:none}
.tab-panel.active{display:block}

/* ── HERO ───────────────────────────────────────────────── */
.hero{
  padding:1.6rem 2rem 1.4rem;
  border-bottom:1px solid var(--border);
  background:var(--bg2);
}
.hero-inner{max-width:1180px;margin:0 auto}
.hero h1{
  font-family:var(--fh);
  font-size:clamp(16px,2.2vw,22px);
  font-weight:700;line-height:1.15;
  letter-spacing:-.01em;
  margin-bottom:.35rem;color:var(--text);
}
.hero h1 .hi{color:var(--accent)}
.hero h1 .hi2{color:var(--trace)}
.hero p{
  color:var(--text2);font-size:12.5px;
  max-width:640px;line-height:1.65;
}

/* ── LAYOUT ─────────────────────────────────────────────── */
.app-grid{
  max-width:1180px;margin:0 auto;
  padding:1.2rem 1.4rem 4rem;
  display:grid;grid-template-columns:280px 1fr;
  gap:1.2rem;align-items:start;
}
@media(max-width:760px){.app-grid{grid-template-columns:1fr}}
.left-col{display:flex;flex-direction:column;gap:.8rem}

/* ── PANELS ─────────────────────────────────────────────── */
.panel{
  background:var(--bg2);
  border:1px solid var(--border);
  border-radius:2px;
  overflow:visible;
}
.ph{
  padding:7px 12px;
  border-bottom:1px solid var(--border);
  display:flex;align-items:center;justify-content:space-between;
  background:var(--bg3);
}
.ph-t{
  font-family:var(--fh);font-size:10.5px;font-weight:700;
  color:var(--text2);letter-spacing:.07em;text-transform:uppercase;
}
.pb{padding:12px 13px}

/* ── FORM ELEMENTS ──────────────────────────────────────── */
.fl{
  display:block;font-size:10px;color:var(--text3);
  letter-spacing:.07em;margin-bottom:3px;
  text-transform:uppercase;margin-top:11px;font-weight:600;
}
.fl:first-child,.fl0{margin-top:0}
input[type="text"],input[type="number"],input[type="datetime-local"],select{
  width:100%;background:var(--bg2);
  border:1px solid var(--border);border-radius:2px;
  color:var(--text);font-family:var(--fh);font-size:12px;
  padding:5px 8px;outline:none;transition:border-color .12s;
}
input:focus,select:focus{
  border-color:var(--accent);
  outline:2px solid rgba(var(--accent-r),var(--accent-g),var(--accent-b),0.14);
  outline-offset:0;
}
select option{background:var(--bg2)}
input[type="number"]{-moz-appearance:textfield}

.ck{display:flex;align-items:center;gap:7px;margin-top:7px}
.ck input[type="checkbox"]{width:13px;height:13px;accent-color:var(--accent);cursor:pointer}
.ck label{font-size:11.5px;color:var(--text2);cursor:pointer;user-select:none}

.divider{height:1px;background:var(--border);margin:10px 0}

/* ── BUTTONS ────────────────────────────────────────────── */
.btn{
  display:block;width:100%;
  border:1px solid transparent;border-radius:2px;
  font-family:var(--fh);font-size:12px;font-weight:600;
  letter-spacing:.02em;
  cursor:pointer;padding:7px 14px;
  transition:background .1s,border-color .1s;
}
.btn:active{opacity:.88}
/* Primary — journal blue */
.btn-a{background:var(--accent);color:#fff;border-color:var(--accent)}
.btn-a:hover{filter:brightness(1.1)}
.btn-a:disabled{opacity:.38;cursor:not-allowed}
/* Trace — violet */
.btn-v{background:var(--trace);color:#fff;border-color:var(--trace);margin-bottom:0}
.btn-v:hover{filter:brightness(1.12)}
.btn-v:disabled{opacity:.38;cursor:not-allowed}
/* Ghost */
.btn-g{
  background:var(--bg2);border:1px solid var(--border);
  color:var(--text2);font-family:var(--fh);font-size:12px;font-weight:500;
  margin-top:6px;
}
.btn-g:hover{border-color:var(--border2);color:var(--text);background:var(--bg3)}
.btn-g:disabled{opacity:.35;cursor:not-allowed}
/* Dashed add */
.btn-add{
  background:none;border:1px dashed var(--border);border-radius:2px;
  color:var(--text3);font-family:var(--fh);font-size:11.5px;
  cursor:pointer;padding:5px;width:100%;
  transition:border-color .12s,color .12s;margin-top:0;
}
.btn-add:hover{border-color:var(--text3);color:var(--text2)}

/* ── STATUS LINE ────────────────────────────────────────── */
.st{font-size:11px;color:var(--text3);margin-top:7px;min-height:14px;font-style:italic}
.st.err{color:var(--danger);font-style:normal;font-weight:500}
.st.ok{color:var(--ok);font-style:normal}

/* ── SHARED FILE BANNER ─────────────────────────────────── */
.shared-banner{
  background:var(--bg3);border:1px solid var(--border2);
  border-radius:2px;padding:8px 10px;
  margin-bottom:8px;animation:fadeUp .22s ease;
}

/* ── DROP ZONE ──────────────────────────────────────────── */
.dz{
  border:1px dashed var(--border2);border-radius:2px;
  padding:18px 14px;text-align:center;cursor:pointer;
  transition:border-color .12s,background .12s;
  position:relative;background:var(--bg3);
}
.dz:hover,.dz.over{
  border-color:var(--accent);
  background:rgba(var(--accent-r),var(--accent-g),var(--accent-b),.05);
}
.dz input[type="file"]{position:absolute;inset:0;opacity:0;cursor:pointer;width:100%;height:100%}
.dz-icon{font-size:14px;color:var(--text3);display:block;margin-bottom:4px}
.dz-text{font-size:11px;color:var(--text2)}
.dz-text strong{color:var(--text);display:block;font-size:12px;margin-bottom:2px;font-weight:600}
.dz-name{
  margin-top:6px;padding:3px 8px;
  background:rgba(var(--accent-r),var(--accent-g),var(--accent-b),.08);
  border-radius:2px;color:var(--accent);font-size:11px;display:none;word-break:break-all;
}

/* ── CIRCATREAT ─────────────────────────────────────────── */
.treat-list{display:flex;flex-direction:column;gap:4px;margin-bottom:10px}
.treat-row{
  display:flex;align-items:center;gap:6px;
  background:var(--bg3);border:1px solid var(--border);
  border-radius:2px;padding:5px 8px;
}
.treat-lbl{font-size:10px;color:var(--text3);min-width:74px;letter-spacing:.04em;text-transform:uppercase}
.treat-row input{flex:1;background:transparent;border:none;color:var(--accent);font-family:var(--fm);font-size:12.5px;outline:none}
.treat-row input::placeholder{color:var(--text3)}
.treat-rm{background:none;border:none;color:var(--text3);cursor:pointer;font-size:14px;padding:0 2px;line-height:1;transition:color .12s}
.treat-rm:hover{color:var(--danger)}

.right-col{display:flex;flex-direction:column;gap:1.1rem}
.stats-row{display:grid;grid-template-columns:repeat(4,1fr);gap:8px}
@media(max-width:560px){.stats-row{grid-template-columns:repeat(2,1fr)}}
/* Stat card: left accent bar shows which tab's data it is */
.sc{
  background:var(--bg2);border:1px solid var(--border);
  border-radius:2px;padding:10px 13px;
  border-left:3px solid var(--accent);
}
.sc-l{font-size:9.5px;color:var(--text3);text-transform:uppercase;letter-spacing:.07em;margin-bottom:3px;font-weight:600}
.sc-v{font-family:var(--fh);font-size:19px;font-weight:700;font-variant-numeric:tabular-nums}

.chart-wrap{position:relative;width:100%;height:240px}
.chart-wrap canvas{position:absolute;top:0;left:0;width:100%;height:100%}

.ct-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(134px,1fr));gap:8px}
.ct-card{
  background:var(--bg3);border:1px solid var(--border);
  border-radius:2px;padding:11px 12px;transition:border-color .12s;
  border-top:3px solid var(--border);
}
.ct-card:hover{border-color:var(--border2)}
.ct-badge{font-size:9.5px;letter-spacing:.06em;text-transform:uppercase;color:var(--text3);margin-bottom:4px;font-weight:600}
.ct-num{font-family:var(--fh);font-size:21px;font-weight:700;letter-spacing:-.01em;margin-bottom:2px;font-variant-numeric:tabular-nums}
.ct-clk{font-size:14px;font-weight:600;color:var(--text);margin-bottom:2px;font-variant-numeric:tabular-nums}
.ct-dt{font-size:11px;color:var(--text2);margin-bottom:4px}
.ct-ph{font-size:10px;color:var(--text3)}

.sched-scroll{overflow-x:auto}
table{width:100%;border-collapse:collapse;font-size:12px}
th{
  text-align:left;padding:7px 11px;
  font-family:var(--fh);font-size:10px;font-weight:700;
  letter-spacing:.06em;text-transform:uppercase;
  color:var(--text2);border-bottom:2px solid var(--border);
  white-space:nowrap;background:var(--bg3);
}
td{padding:6px 11px;border-bottom:1px solid var(--border);white-space:nowrap;font-family:var(--fh);font-size:12.5px}
tr:last-child td{border-bottom:none}
tr:hover td{background:var(--bg4)}
.td-d{color:var(--text3);font-size:11px}
.td-m{font-family:var(--fm)}

.treat-placeholder,.trace-placeholder{
  display:flex;flex-direction:column;align-items:center;justify-content:center;
  min-height:400px;color:var(--text3);text-align:center;
  padding:2rem;border:1px solid var(--border);
  border-radius:2px;background:var(--bg2);
}
.ph-ico{font-size:24px;opacity:.14;margin-bottom:.8rem}
.treat-placeholder p,.trace-placeholder p{font-size:12.5px;max-width:260px;line-height:1.8}

.note{
  background:var(--bg3);border:1px solid var(--border);
  border-left:3px solid var(--accent);border-radius:0 2px 2px 0;
  padding:9px 13px;font-size:11.5px;color:var(--text2);line-height:1.75;
}

/* ── CIRCATRACE ─────────────────────────────────────────── */
.trace-list{display:flex;flex-direction:column;gap:5px;margin-top:8px}
.ti{
  background:var(--bg3);border:1px solid var(--border);
  border-radius:2px;padding:7px 10px;
  display:flex;flex-direction:column;gap:4px;
}
.ti-top{display:flex;align-items:center;gap:7px}
.tswatch{width:18px;height:18px;border-radius:2px;flex-shrink:0;border:1px solid var(--border2);position:relative;cursor:pointer}
.tswatch input[type="color"]{position:absolute;inset:0;opacity:0;cursor:pointer;width:100%;height:100%;padding:0;border:none}
.tlw{flex:1;min-width:0}
.tlabel{
  width:100%;background:transparent;border:none;
  border-bottom:1px solid transparent;
  color:var(--text);font-family:var(--fm);font-size:11px;
  padding:1px 2px;outline:none;transition:border-color .12s;cursor:text;
}
.tlabel:hover{border-bottom-color:var(--border2)}
.tlabel:focus{border-bottom-color:var(--trace)}
.tfn{font-size:9px;color:var(--text3);overflow:hidden;text-overflow:ellipsis;white-space:nowrap;margin-top:1px}
.trm{background:none;border:none;color:var(--text3);cursor:pointer;font-size:14px;padding:0;line-height:1;flex-shrink:0;transition:color .12s}
.trm:hover{color:var(--danger)}
.tmeta{font-size:9px;color:var(--text3);font-variant-numeric:tabular-nums}

.bg-toggle{display:flex;gap:3px;margin-top:6px}
.bg-pill{
  flex:1;padding:4px;border-radius:2px;
  border:1px solid var(--border);background:var(--bg3);
  color:var(--text2);font-family:var(--fh);font-size:11px;font-weight:500;
  cursor:pointer;text-align:center;transition:all .1s;user-select:none;
}
.bg-pill.active{border-color:var(--trace);background:rgba(74,53,128,.1);color:var(--trace)}

.pgrid{display:grid;grid-template-columns:repeat(8,1fr);gap:3px;margin-top:6px}
.psw{width:100%;aspect-ratio:1;border-radius:2px;cursor:pointer;border:2px solid transparent;transition:border-color .12s,transform .1s}
.psw:hover{transform:scale(1.15)}

.xrow{display:flex;gap:6px;margin-top:6px}
.xrow select{flex:1}
.xrow .btn{width:auto;flex:2;margin:0}

/* Publication-quality chart wrapper */
.cwrap{
  background:var(--bg2);border:1px solid var(--border);
  border-radius:2px;overflow:hidden;transition:background .25s;
}
.cwrap.pw{background:#ffffff}
.cwrap.po{background:#f8f7f2}
.cinner{padding:16px 16px 12px}
.trow{display:flex;gap:10px;margin-bottom:8px;flex-wrap:wrap}
.trow input{
  background:transparent;border:none;
  border-bottom:1px solid var(--border2);border-radius:0;
  color:var(--text);font-family:var(--fh);
  font-size:13px;font-weight:700;padding:2px 4px;
  flex:1;min-width:0;outline:none;transition:border-color .18s;
}
.trow input:focus{border-bottom-color:var(--trace)}
.trow input::placeholder{color:var(--text3)}
.trow input.tsub{font-size:11px;font-family:var(--fm);font-weight:400;color:var(--text2)}
.cwrap.pw .trow input,.cwrap.po .trow input{color:#111827}
.cwrap.pw .trow input::placeholder,.cwrap.po .trow input::placeholder{color:#aaa}

.legwrap{display:flex;flex-wrap:wrap;gap:8px;margin-bottom:8px}
.legitem{display:flex;align-items:center;gap:5px;font-size:11px;color:var(--text2)}
.legdot{width:18px;height:2.5px;border-radius:1px}
.cwrap.pw .legitem,.cwrap.po .legitem{color:#374151}
canvas#TC{display:block;width:100%;border-radius:1px}

/* ── CIRCATRENDS ────────────────────────────────────────── */
.btn-t{background:var(--trend);color:#fff;border-color:var(--trend)}
.btn-t:hover{filter:brightness(1.1)}
.btn-t:disabled{opacity:.35;cursor:not-allowed}
input[type="checkbox"].accent-trend{accent-color:var(--trend)}

.data-table-wrap{overflow:auto;max-height:340px;border:1px solid var(--border);border-radius:2px}
.data-table{width:max-content;min-width:100%;border-collapse:collapse;font-size:11px}
.data-table th{
  background:var(--bg4);color:var(--text2);
  padding:6px 10px;border-bottom:2px solid var(--border);
  white-space:nowrap;font-family:var(--fh);
  font-size:9px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;
  position:sticky;top:0;z-index:2;
}
.data-table td{padding:5px 10px;border-bottom:1px solid var(--border);white-space:nowrap;font-family:var(--fm)}
.data-table tr:last-child td{border-bottom:none}
.data-table tr:hover td{background:var(--bg4)}
.data-table td.sample-id{color:var(--text);font-weight:500;position:sticky;left:0;background:var(--bg2);z-index:1}
.data-table td.grp-cell{padding:4px 8px}
.grp-sel{
  background:var(--bg3);border:1px solid var(--border2);border-radius:2px;
  color:var(--text);font-family:var(--fm);font-size:11px;
  padding:2px 6px;width:100%;outline:none;
}
.grp-sel:focus{border-color:var(--trend)}

.group-list{display:flex;flex-direction:column;gap:5px;margin-top:8px}
.group-item{
  display:flex;align-items:center;gap:8px;
  background:var(--bg3);border:1px solid var(--border);
  border-radius:2px;padding:6px 10px;
}
.group-swatch{width:15px;height:15px;border-radius:2px;flex-shrink:0;border:1px solid var(--border2);position:relative;cursor:pointer}
.group-swatch input[type="color"]{position:absolute;inset:0;opacity:0;cursor:pointer;width:100%;height:100%;padding:0;border:none}
.group-name-inp{flex:1;background:transparent;border:none;border-bottom:1px solid transparent;color:var(--text);font-family:var(--fm);font-size:12px;padding:1px 2px;outline:none;transition:border-color .12s}
.group-name-inp:hover{border-bottom-color:var(--border2)}
.group-name-inp:focus{border-bottom-color:var(--trend)}
.grm{background:none;border:none;color:var(--text3);cursor:pointer;font-size:14px;padding:0;line-height:1;transition:color .12s}
.grm:hover{color:var(--danger)}

.stats-results{display:flex;flex-direction:column;gap:.9rem;margin-top:0}
.param-block{background:var(--bg2);border:1px solid var(--border);border-radius:2px;overflow:hidden}
.param-block-head{
  padding:7px 13px;background:var(--bg3);
  border-bottom:1px solid var(--border);
  display:flex;align-items:center;justify-content:space-between;
}
.param-block-title{font-family:var(--fh);font-size:10.5px;font-weight:700;color:var(--text2);letter-spacing:.04em;text-transform:uppercase}
.param-block-body{padding:13px}
.stat-sig{font-size:12px;color:var(--text2);margin-top:7px;line-height:1.9}
.stat-sig b{color:var(--text)}
.sig-badge{
  display:inline-block;padding:1px 6px;border-radius:2px;
  font-size:10px;margin-left:4px;font-family:var(--fm);font-weight:600;
}
.sig-yes{background:rgba(26,107,82,.1);color:var(--trend);border:1px solid rgba(26,107,82,.2)}
.sig-no{background:var(--bg4);color:var(--text3);border:1px solid var(--border)}

.trend-chart-wrap{position:relative;width:100%;height:240px}
.trend-chart-wrap canvas{position:absolute;top:0;left:0;width:100%;height:100%}

.pal-upload-row{display:flex;gap:6px;align-items:center;margin-top:8px}
.pal-upload-row input[type="file"]{display:none}
.pal-upload-btn{
  flex:1;padding:5px 8px;border-radius:2px;
  border:1px dashed var(--border2);background:var(--bg3);
  color:var(--text2);font-family:var(--fm);font-size:11px;
  cursor:pointer;text-align:center;transition:border-color .12s,color .12s;
}
.pal-upload-btn:hover{border-color:var(--accent);color:var(--accent)}
.custom-pal-swatches{display:flex;flex-wrap:wrap;gap:3px;margin-top:6px}
.custom-psw{width:17px;height:17px;border-radius:2px;cursor:pointer;border:2px solid transparent;transition:transform .1s}
.custom-psw:hover{transform:scale(1.18)}

/* ── ANIMATION + SCROLLBAR ──────────────────────────────── */
@keyframes fu{from{opacity:0;transform:translateY(6px)}to{opacity:1;transform:translateY(0)}}
.fu{animation:fu .24s ease both}
@media(prefers-reduced-motion:reduce){.fu{animation:none}}
::-webkit-scrollbar{width:5px;height:5px}
::-webkit-scrollbar-track{background:var(--bg3)}
::-webkit-scrollbar-thumb{background:var(--border2);border-radius:0}

/* ── FAQ / DOCS TAB ─────────────────────────────────────── */
.active-faq{border-bottom-color:var(--accent)!important;color:var(--accent)!important}
.faq-wrap{max-width:860px;margin:0 auto;padding:2.5rem 1.5rem 4rem}
.faq-hero{margin-bottom:2.5rem}
.faq-hero h1{font-size:1.55rem;font-weight:700;color:var(--text);margin:0 0 .55rem;letter-spacing:-.01em}
.faq-hero p{font-size:.92rem;color:var(--text2);margin:0;max-width:62ch;line-height:1.65}
.faq-section{margin-bottom:2.5rem}
.faq-section-title{font-size:.68rem;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:var(--text3);padding-bottom:.5rem;border-bottom:1px solid var(--border);margin-bottom:1rem}
.faq-item{border:1px solid var(--border);border-radius:2px;margin-bottom:.4rem;background:var(--bg2)}
.faq-q{width:100%;text-align:left;background:none;border:none;padding:.75rem 1rem;font-family:var(--fh);font-size:.875rem;font-weight:600;color:var(--text);cursor:pointer;display:flex;justify-content:space-between;align-items:center;gap:1rem;line-height:1.4}
.faq-q:hover{background:var(--bg3)}
.faq-q .faq-chevron{flex-shrink:0;font-size:.75rem;color:var(--text3);transition:transform .18s}
.faq-item.open .faq-chevron{transform:rotate(180deg)}
.faq-a{display:none;padding:.1rem 1rem 1rem;font-size:.85rem;color:var(--text2);line-height:1.7;border-top:1px solid var(--border)}
.faq-item.open .faq-a{display:block}
.faq-a p{margin:.65rem 0 0}
.faq-a p:first-child{margin-top:.55rem}
.faq-a ul,.faq-a ol{margin:.5rem 0 .5rem 1.2rem;padding:0}
.faq-a li{margin-bottom:.3rem}
.faq-a code{font-family:var(--fm);font-size:.82em;background:var(--bg4);padding:.1em .35em;border-radius:2px;color:var(--text)}
.faq-a strong{color:var(--text);font-weight:600}
.faq-a .methods-box{background:var(--bg3);border-left:3px solid var(--accent);border-radius:0 2px 2px 0;padding:.75rem 1rem;margin:.75rem 0;font-size:.82rem;font-style:italic;line-height:1.65;color:var(--text2)}
.faq-a .methods-box strong{font-style:normal}
.faq-tag{display:inline-block;font-size:.68rem;font-weight:600;padding:.1em .45em;border-radius:2px;background:var(--bg4);color:var(--text3);letter-spacing:.04em;margin-left:.4rem;vertical-align:middle;text-transform:uppercase}
.faq-tag.treat{background:color-mix(in srgb,var(--accent) 12%,var(--bg2));color:var(--accent)}
.faq-tag.trace{background:color-mix(in srgb,var(--trace) 12%,var(--bg2));color:var(--trace)}
.faq-tag.trend{background:color-mix(in srgb,var(--trend) 12%,var(--bg2));color:var(--trend)}

/* ── FOOTER ─────────────────────────────────────────────── */
footer{
  border-top:1px solid var(--border);
  padding:.9rem 2rem;text-align:center;
  font-size:11px;color:var(--text3);
  background:var(--bg2);letter-spacing:.03em;
  font-family:var(--fh);
}
</style>
</head>
<body>

<!-- ═══════════════════════════════════════════════════════════
     HEADER
═══════════════════════════════════════════════════════════════ -->
<header>
  <div class="header-brand">
    <div class="brand-icon">◑</div>
    <span class="brand-name"><em>Circa</em>Thread</span>
    <span class="brand-tag">Circadian Suite</span>
  </div>

  <nav class="tab-nav">
    <button class="tab-btn active-treat" id="tab-treat" onclick="switchTab('treat')">
      CircATreat
      <span class="tab-pill">Treatment Scheduler</span>
    </button>
    <button class="tab-btn" id="tab-trace" onclick="switchTab('trace')">
      CircATrace
      <span class="tab-pill">Publication Plotter</span>
    </button>
    <button class="tab-btn" id="tab-trend" onclick="switchTab('trend')">
      CircATrends
      <span class="tab-pill">Statistical Analysis</span>
    </button>
    <button class="tab-btn" id="tab-faq" onclick="switchTab('faq')">
      Docs &amp; FAQ
      <span class="tab-pill">Guide &amp; Methods</span>
    </button>
  </nav>

  <div class="header-right">
    <span class="hcopyright">© Topping et al. 2026</span>
  </div>
</header>


<!-- ═══════════════════════════════════════════════════════════
     TAB 1 — CircATreat
═══════════════════════════════════════════════════════════════ -->
<div class="tab-panel active" id="panel-treat">

  <div class="hero">
    <h1>Circadian Treatment<br><span class="hi">Time Predictor</span></h1>
    <p>Upload one or more LumiCycle CSVs, set your desired circadian times, and get real-world treatment schedules. With multiple files, <strong>Absolute</strong> shows each replicate's CT times independently; <strong>Optimum</strong> gives a consensus clock time where all replicates agree within 20 min.</p>
  </div>

  <div class="app-grid">
    <div class="left-col">

      <div class="panel">
        <div class="ph">
          <span class="ph-t">1 — Data files</span>
          <span style="font-size:10px;color:var(--text3)" id="AT-fcnt">0 loaded</span>
        </div>
        <div class="pb">
          <div id="AT-dz-wrap">
          <div class="dz" id="AT-dz">
            <input type="file" id="AT-fi" accept=".csv,.txt" multiple>
            <span class="dz-icon">↑</span>
            <div class="dz-text"><strong>Browse or drop CSV files</strong>Multiple files supported — each is one replicate</div>
          </div>
          </div>
          <div id="AT-flist" style="display:flex;flex-direction:column;gap:6px;margin-top:9px"></div>
        </div>
      </div>

      <div class="panel">
        <div class="ph"><span class="ph-t">2 — Multi-file options</span></div>
        <div class="pb">
          <div class="ck" style="margin-top:0">
            <input type="checkbox" id="AT-avg" checked>
            <label for="AT-avg">Average traces on chart</label>
          </div>
          <p style="font-size:10px;color:var(--text3);margin-top:5px;line-height:1.6">Interpolates traces to a shared time axis — mean ± SD envelope overlaid in white. Individual traces shown at reduced opacity.</p>
        </div>
      </div>

      <div class="panel">
        <div class="ph"><span class="ph-t">3 — Reporter cassette</span></div>
        <div class="pb">
          <label class="fl" style="margin-top:0">Bioluminescence reporter</label>
          <select id="AT-cassette">
            <option value="none">None / unknown (no CT annotation)</option>
            <optgroup label="Core clock — activators">
              <option value="bmal1">Bmal1::Luc &nbsp;— peak ≈ CT0</option>
              <option value="clock">Clock::Luc &nbsp;— peak ≈ CT0</option>
            </optgroup>
            <optgroup label="Core clock — repressors">
              <option value="per1">Per1::Luc &nbsp;— peak ≈ CT8</option>
              <option value="per2">Per2::Luc &nbsp;— peak ≈ CT12</option>
              <option value="per3">Per3::Luc &nbsp;— peak ≈ CT10</option>
              <option value="cry1">Cry1::Luc &nbsp;— peak ≈ CT16</option>
              <option value="cry2">Cry2::Luc &nbsp;— peak ≈ CT14</option>
            </optgroup>
            <optgroup label="Auxiliary loop">
              <option value="reverba">Rev-erbα::Luc &nbsp;— peak ≈ CT4</option>
              <option value="rora">RORα::Luc &nbsp;— peak ≈ CT20</option>
              <option value="dbp">Dbp::Luc &nbsp;— peak ≈ CT8</option>
              <option value="tef">Tef::Luc &nbsp;— peak ≈ CT8</option>
            </optgroup>
            <optgroup label="Custom">
              <option value="custom">Custom peak CT →</option>
            </optgroup>
          </select>
          <div id="AT-custom-ct-row" style="display:none;margin-top:7px;display:none;align-items:center;gap:7px">
            <label style="font-size:10px;color:var(--text3);white-space:nowrap">Peak corresponds to CT:</label>
            <input type="number" id="AT-custom-ct" value="0" min="0" max="23.9" step="0.5"
              style="width:60px;font-size:11px;padding:3px 6px;background:var(--bg2);border:1px solid var(--border);border-radius:3px;color:var(--text);font-family:var(--fm)">
          </div>
          <p style="font-size:10px;color:var(--text3);margin-top:7px;line-height:1.6">
            Selecting a cassette annotates each treatment time with its circadian time (CT) based on the known phase of the reporter peak. Results still show the clock time; CT is an additional label only. Peak CT values are canonical literature values for SCN/fibroblasts under LD conditions — adjust using Custom if your system differs.
          </p>
        </div>
      </div>

      <div class="panel">
        <div class="ph"><span class="ph-t">4 — Treatment times</span></div>
        <div class="pb">
          <div class="treat-list" id="AT-tl"></div>
          <button class="btn-add" id="AT-add">+ add treatment time</button>
        </div>
      </div>

      <div class="panel">
        <div class="pb">
          <button class="btn btn-a" id="AT-run">Analyse →</button>
          <button class="btn btn-g" id="AT-demo">Run with demo data</button>
          <button class="btn btn-g" id="AT-save" disabled>⬇ Save report (.txt)</button>
          <div class="st" id="AT-st">Load a CSV or run the demo to begin.</div>
        </div>
      </div>

    </div>

    <div class="right-col" id="AT-right">
      <div class="treat-placeholder">
        <div class="ph-ico">◑</div>
        <p>Results will appear here once you run the analysis.</p>
      </div>
    </div>
  </div>
</div>


<!-- ═══════════════════════════════════════════════════════════
     TAB 2 — CircATrace
═══════════════════════════════════════════════════════════════ -->
<div class="tab-panel" id="panel-trace">

  <div class="hero">
    <h1>Bioluminescence<br><span class="hi2">Publication Plotter</span></h1>
    <p>Overlay multiple LumiCycle traces, label each one independently, and export publication-quality figures at up to 600 dpi in PNG, JPEG, or TIFF.</p>
  </div>

  <div class="app-grid">
    <div class="left-col">

      <!-- Traces -->
      <div class="panel">
        <div class="ph">
          <span class="ph-t">Traces</span>
          <span style="font-size:10px;color:var(--text3)" id="AC-cnt">0 loaded</span>
        </div>
        <div class="pb">
          <div id="AC-dz-wrap">
          <div class="dz" id="AC-dz">
            <input type="file" id="AC-fi" accept=".csv,.txt" multiple>
            <span class="dz-icon">↑</span>
            <div class="dz-text"><strong>Drop CSV files here</strong>Multiple files — click to browse</div>
          </div>
          </div>
          <div class="trace-list" id="AC-tl"></div>
        </div>
      </div>

      <!-- Palette -->
      <div class="panel">
        <div class="ph"><span class="ph-t">Colour palette</span></div>
        <div class="pb">
          <label class="fl fl0">Preset</label>
          <select id="AC-pal">
            <optgroup label="Colourblind friendly">
              <option value="okabe">Okabe–Ito (universal CB)</option>
              <option value="wong">Wong 8-colour</option>
              <option value="tol">Paul Tol muted</option>
              <option value="ibm">IBM Carbon</option>
            </optgroup>
            <optgroup label="Greyscale / monochrome">
              <option value="grey5">5-step greyscale</option>
              <option value="grey8">8-step greyscale</option>
              <option value="blackgrey">Black + greys</option>
              <option value="monodash">Black — varied dash</option>
            </optgroup>
          </select>
          <div class="pgrid" id="AC-pg"></div>
          <button class="btn btn-g" id="AC-applypal" style="margin-top:8px">Apply to all traces</button>
        </div>
      </div>

      <!-- Options -->
      <div class="panel">
        <div class="ph"><span class="ph-t">Plot options</span></div>
        <div class="pb">
          <label class="fl fl0">Plot background</label>
          <div class="bg-toggle">
            <div class="bg-pill active" data-bg="dark" id="AC-bgd">Dark</div>
            <div class="bg-pill" data-bg="white" id="AC-bgw">White</div>
            <div class="bg-pill" data-bg="offwhite" id="AC-bgo">Off-white</div>
          </div>
          <label class="fl">Smoothing (pts)</label>
          <input type="number" id="AC-sm" value="11" min="1" max="51" step="2">
          <label class="fl">Line width</label>
          <input type="number" id="AC-lw" value="2" min="0.5" max="6" step="0.5">
          <div class="ck"><input type="checkbox" id="AC-pk" checked><label for="AC-pk">Peak markers ▲</label></div>
          <div class="ck"><input type="checkbox" id="AC-tr" checked><label for="AC-tr">Trough markers ◆</label></div>
